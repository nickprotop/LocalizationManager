@page "/editor"
@using LocalizationManager.Services
@using LocalizationManager.Models.Api
@inject ResourceApiClient ResourceApi
@inject MergeDuplicatesApiClient MergeDuplicatesApi
@inject ValidationApiClient ValidationApi
@inject ScanApiClient ScanApi
@inject ScanCacheService ScanCache
@inject SearchApiClient SearchApi
@inject NavigationManager Navigation
@inject DialogService DialogService
@inject NotificationService NotificationService

<PageTitle>Editor - Localization Manager</PageTitle>

<RadzenText TextStyle="TextStyle.H4" class="rz-mb-4">Resource Editor</RadzenText>

@if (isLoading)
{
    <RadzenCard>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
            <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Small" />
            <RadzenText>Loading resources...</RadzenText>
        </RadzenStack>
    </RadzenCard>
}
else if (errorMessage != null)
{
    <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" Shade="Shade.Dark" AllowClose="true" Close="@(() => errorMessage = null)">
        <strong>Error:</strong> @errorMessage
        <RadzenButton Text="Retry" Size="ButtonSize.Small" class="rz-ml-2" Click="@LoadResources" />
    </RadzenAlert>
}
else if (keys != null && languages != null)
{
    <!-- Toolbar -->
    <RadzenCard class="rz-mb-4">
        <RadzenStack Gap="0.75rem">
            <!-- Search Row -->
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Wrap="FlexWrap.Wrap">
                <RadzenTextBox @bind-Value="@searchFilter" Placeholder="@GetSearchPlaceholder()"
                              Style="width: 300px;" @oninput="OnSearchInput" />
                @if (!string.IsNullOrEmpty(searchFilter))
                {
                    <RadzenButton Icon="close" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" Click="@ClearSearch" />
                }

                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.25rem">
                    <RadzenCheckBox @bind-Value="@useWildcard" Name="cbWildcard" Change="@((bool _) => OnFilterModeChanged())" />
                    <RadzenLabel Text="Wildcard" Component="cbWildcard" class="rz-text-secondary-color" />
                </RadzenStack>

                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.25rem">
                    <RadzenCheckBox @bind-Value="@useRegex" Name="cbRegex" Change="@((bool _) => OnFilterModeChanged())" />
                    <RadzenLabel Text="Regex" Component="cbRegex" class="rz-text-secondary-color" />
                </RadzenStack>

                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.25rem">
                    <RadzenCheckBox @bind-Value="@caseSensitive" Name="cbCase" Change="@((bool _) => OnFilterModeChanged())" />
                    <RadzenLabel Text="Match Case" Component="cbCase" class="rz-text-secondary-color" />
                </RadzenStack>

                <RadzenText TextStyle="TextStyle.Body2" class="rz-color-secondary">
                    @filteredKeys.Count / @keys.Count keys
                    @if (scanResult != null)
                    {
                        <text> | Scanned</text>
                    }
                </RadzenText>
            </RadzenStack>

            <!-- Actions Row -->
            <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" Wrap="FlexWrap.Wrap">
                <RadzenButton Text="Add Key" Icon="add" Click="@(() => Navigation.NavigateTo("/editor/add"))" />

                @if (duplicateCount > 0)
                {
                    <RadzenButton Text="@($"Merge Duplicates ({duplicateCount})")" Icon="merge_type"
                                 ButtonStyle="ButtonStyle.Warning" Click="@(() => Navigation.NavigateTo("/editor/merge-duplicates"))" />
                }

                <RadzenButton Text="@(isScanning ? "Scanning..." : "Scan Code")" Icon="search"
                             ButtonStyle="ButtonStyle.Secondary" Click="@RunCodeScan" Disabled="@isScanning" />

                <RadzenButton Text="Refresh" Icon="refresh" ButtonStyle="ButtonStyle.Light" Click="@LoadResources" />
            </RadzenStack>

            <!-- Bulk Actions Row (shown when items are selected) -->
            @if (selectedKeys.Count > 0)
            {
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem"
                            class="rz-p-2 rz-border-radius-1" Style="background: var(--rz-primary-lighter);">
                    <RadzenText TextStyle="TextStyle.Body2">
                        <strong>@selectedKeys.Count</strong> @(selectedKeys.Count == 1 ? "key" : "keys") selected
                    </RadzenText>
                    <RadzenButton Text="Translate Selected" Icon="translate" Size="ButtonSize.Small" Click="@BulkTranslate" />
                    <RadzenButton Text="Delete Selected" Icon="delete" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Danger" Click="@BulkDelete" />
                    <RadzenButton Text="Clear Selection" Icon="clear" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" Click="@ClearSelection" />
                </RadzenStack>
            }
        </RadzenStack>
    </RadzenCard>

    <!-- Filter Panel -->
    <RadzenCard class="rz-mb-4">
        <RadzenStack Gap="0.75rem">
            <!-- Status Filters -->
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem" Wrap="FlexWrap.Wrap">
                <RadzenText TextStyle="TextStyle.Body2" class="rz-color-secondary">Status:</RadzenText>

                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.25rem">
                    <RadzenCheckBox @bind-Value="@filterMissing" Name="cbMissing" Change="@((bool _) => OnFilterModeChanged())" />
                    <RadzenLabel Component="cbMissing">
                        <span class="rz-color-danger">Missing (@missingCount)</span>
                    </RadzenLabel>
                </RadzenStack>

                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.25rem">
                    <RadzenCheckBox @bind-Value="@filterExtra" Name="cbExtra" Change="@((bool _) => OnFilterModeChanged())" />
                    <RadzenLabel Component="cbExtra">
                        <span class="rz-color-warning">Extra (@extraCount)</span>
                    </RadzenLabel>
                </RadzenStack>

                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.25rem">
                    <RadzenCheckBox @bind-Value="@filterDuplicates" Name="cbDups" Change="@((bool _) => OnFilterModeChanged())" />
                    <RadzenLabel Component="cbDups">
                        <span style="color: var(--rz-warning);">Duplicates (@duplicateCount)</span>
                    </RadzenLabel>
                </RadzenStack>

                @if (scanResult != null)
                {
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.25rem">
                        <RadzenCheckBox @bind-Value="@filterUnused" Name="cbUnused" Change="@((bool _) => ApplyLocalFilters())" />
                        <RadzenLabel Component="cbUnused" class="rz-color-secondary">
                            Unused (@unusedKeys.Count)
                        </RadzenLabel>
                    </RadzenStack>

                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.25rem">
                        <RadzenCheckBox @bind-Value="@filterMissingFromCode" Name="cbMissingCode" Change="@((bool _) => ApplyLocalFilters())" />
                        <RadzenLabel Component="cbMissingCode" class="rz-color-danger">
                            Missing in Resources (@missingFromResources.Count)
                        </RadzenLabel>
                    </RadzenStack>
                }
            </RadzenStack>

            <!-- Language Filters -->
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem" Wrap="FlexWrap.Wrap">
                <RadzenText TextStyle="TextStyle.Body2" class="rz-color-secondary">Languages:</RadzenText>
                @foreach (var lang in languages)
                {
                    var langCode = lang.Code ?? "default";
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.25rem">
                        <RadzenCheckBox Value="@visibleLanguages.Contains(langCode)" Name="@($"cbLang_{langCode}")"
                                       ValueChanged="@((bool v) => ToggleLanguage(langCode, v))" />
                        <RadzenLabel Component="@($"cbLang_{langCode}")">@langCode</RadzenLabel>
                    </RadzenStack>
                }
            </RadzenStack>
        </RadzenStack>
    </RadzenCard>

    <!-- Missing from Resources Alert -->
    @if (filterMissingFromCode && missingFromResources.Count > 0)
    {
        <RadzenAlert AlertStyle="AlertStyle.Warning" Variant="Variant.Flat" Shade="Shade.Dark" AllowClose="false" class="rz-mb-4">
            <RadzenText TextStyle="TextStyle.H6" class="rz-mb-2">Keys Found in Code but Missing from Resources</RadzenText>
            <RadzenText class="rz-mb-2">These keys are referenced in source code but don't exist in your resource files:</RadzenText>
            <ul>
                @foreach (var key in missingFromResources.Take(20))
                {
                    <li><code class="key-name">@key</code></li>
                }
                @if (missingFromResources.Count > 20)
                {
                    <li><em>...and @(missingFromResources.Count - 20) more</em></li>
                }
            </ul>
        </RadzenAlert>
    }

    <!-- Data Grid -->
    <RadzenCard>
        <RadzenDataGrid @ref="grid" Data="@filteredKeys" TItem="ResourceKeyInfo" AllowSorting="true"
                       AllowPaging="true" PageSize="50" PagerHorizontalAlign="HorizontalAlign.Center"
                       SelectionMode="DataGridSelectionMode.Multiple" @bind-Value="@selectedItems"
                       RowRender="@OnRowRender" Style="height: auto;">
            <Columns>
                <RadzenDataGridColumn TItem="ResourceKeyInfo" Width="50px" Sortable="false" Filterable="false">
                    <HeaderTemplate>
                        <RadzenCheckBox Value="@IsAllVisibleSelected()" TValue="bool"
                                       ValueChanged="@((bool v) => ToggleSelectAll(v))" />
                    </HeaderTemplate>
                    <Template Context="item">
                        <RadzenCheckBox Value="@selectedKeys.Contains(item.Key)" TValue="bool"
                                       ValueChanged="@((bool v) => ToggleKeySelection(item.Key, v))" />
                    </Template>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn TItem="ResourceKeyInfo" Title="Status" Width="80px" Sortable="false">
                    <Template Context="item">
                        @{
                            var status = GetKeyStatus(item);
                        }
                        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.25rem">
                            @foreach (var icon in status.Icons)
                            {
                                <RadzenBadge BadgeStyle="@icon.BadgeStyle" title="@icon.Title" Text="@icon.Symbol" />
                            }
                        </RadzenStack>
                    </Template>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn TItem="ResourceKeyInfo" Property="Key" Title="Key" Width="250px" Frozen="true">
                    <Template Context="item">
                        <span class="key-name">@item.Key</span>
                        @if (item.HasDuplicates)
                        {
                            <RadzenBadge BadgeStyle="BadgeStyle.Warning" Text="@($"x{item.OccurrenceCount}")" class="rz-ml-1" />
                        }
                    </Template>
                </RadzenDataGridColumn>

                @foreach (var lang in languages.Where(l => visibleLanguages.Contains(l.Code ?? "default")))
                {
                    var langCode = lang.Code ?? "default";
                    <RadzenDataGridColumn TItem="ResourceKeyInfo" Title="@langCode" Width="200px">
                        <Template Context="item">
                            @{
                                var value = item.Values.ContainsKey(langCode) ? item.Values[langCode] : null;
                                var isEmpty = string.IsNullOrWhiteSpace(value);
                            }
                            @if (isEmpty)
                            {
                                <em class="rz-color-secondary">(empty)</em>
                            }
                            else if (value!.Length > 50)
                            {
                                <span title="@value">@value.Substring(0, 47)...</span>
                            }
                            else
                            {
                                <span>@value</span>
                            }
                            @if (item.HasLanguageConflict && item.ConflictingLanguages.Contains(langCode))
                            {
                                <span class="rz-color-warning rz-ml-1"
                                      title="@($"Both the default file and a .{langCode} file define this language; showing the default file's value.")">⚠</span>
                            }
                        </Template>
                    </RadzenDataGridColumn>
                }

                <RadzenDataGridColumn TItem="ResourceKeyInfo" Title="Actions" Width="150px" Sortable="false" Filterable="false" TextAlign="TextAlign.Center">
                    <Template Context="item">
                        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.25rem" JustifyContent="JustifyContent.Center">
                            <RadzenButton Icon="edit" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light"
                                         Click="@(() => Navigation.NavigateTo($"/editor/key/{Uri.EscapeDataString(item.Key)}"))"
                                         title="Edit and translate" />
                            <RadzenButton Icon="code" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light"
                                         Click="@(() => ViewReferences(item.Key))" title="View code references" />
                            <RadzenButton Icon="delete" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Danger"
                                         Click="@(() => DeleteKey(item.Key))" title="Delete this key" />
                        </RadzenStack>
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>

        @if (filteredKeys.Count == 0)
        {
            <RadzenText class="rz-p-4 rz-color-secondary rz-text-align-center">No keys match the current filters.</RadzenText>
        }
    </RadzenCard>
}

@code {
    private RadzenDataGrid<ResourceKeyInfo>? grid;

    // Data
    private List<ResourceKeyInfo>? keys;
    private List<ResourceFileInfo>? languages;
    private List<ResourceKeyInfo> filteredKeys = new();
    private IList<ResourceKeyInfo> selectedItems = new List<ResourceKeyInfo>();
    private ScanResponse? scanResult;
    private ValidationResponse? validationResult;

    // Computed status sets
    private HashSet<string> missingTranslationKeys = new();
    private HashSet<string> extraKeys = new();
    private HashSet<string> unusedKeys = new();
    private HashSet<string> missingFromResources = new();

    // Counts
    private int missingCount = 0;
    private int extraCount = 0;
    private int duplicateCount = 0;

    // UI State
    private bool isLoading = true;
    private bool isScanning = false;
    private bool isLoadingReferences = false;
    private string? errorMessage;

    // Search & Filters
    private string searchFilter = "";
    private bool useWildcard = false;
    private bool useRegex = false;
    private bool caseSensitive = false;
    private bool filterMissing = false;
    private bool filterExtra = false;
    private bool filterDuplicates = false;
    private bool filterUnused = false;
    private bool filterMissingFromCode = false;
    private HashSet<string> visibleLanguages = new();

    // Debounce for search
    private CancellationTokenSource? _searchDebounceToken;
    private const int SearchDebounceMs = 300;

    // Multi-select state
    private HashSet<string> selectedKeys = new();

    // Default language code
    private string? defaultLanguageCode;

    protected override async Task OnInitializedAsync()
    {
        // Load scan results from cache if available
        if (ScanCache.HasCachedScan && ScanCache.ScanResult != null)
        {
            scanResult = ScanCache.ScanResult;
            unusedKeys = scanResult.Unused?.ToHashSet() ?? new HashSet<string>();
            missingFromResources = scanResult.Missing?.ToHashSet() ?? new HashSet<string>();
        }

        await LoadResources();
    }

    private async Task LoadResources()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            languages = (await ResourceApi.GetResourceFilesAsync())?.ToList();

            if (languages != null)
            {
                var defaultLang = languages.FirstOrDefault(l => l.IsDefault);
                defaultLanguageCode = defaultLang?.Code ?? "default";

                if (visibleLanguages.Count == 0)
                {
                    foreach (var lang in languages)
                    {
                        visibleLanguages.Add(lang.Code ?? "default");
                    }
                }
            }

            keys = (await ResourceApi.GetAllKeysAsync())?.ToList();

            try
            {
                validationResult = await ValidationApi.ValidateAsync();
                ComputeValidationStatus();
            }
            catch { }

            await PerformSearchAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to load resources: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ComputeValidationStatus()
    {
        missingTranslationKeys.Clear();
        extraKeys.Clear();
        missingCount = 0;
        extraCount = 0;
        duplicateCount = 0;

        if (validationResult != null)
        {
            foreach (var kvp in validationResult.MissingKeys)
            {
                foreach (var key in kvp.Value)
                {
                    missingTranslationKeys.Add(key);
                }
            }
            missingCount = missingTranslationKeys.Count;

            foreach (var kvp in validationResult.ExtraKeys)
            {
                foreach (var key in kvp.Value)
                {
                    extraKeys.Add(key);
                }
            }
            extraCount = extraKeys.Count;
        }

        if (keys != null)
        {
            duplicateCount = keys.Count(k => k.HasDuplicates);
        }
    }

    private async Task RunCodeScan()
    {
        isScanning = true;
        try
        {
            scanResult = await ScanApi.ScanAsync();
            if (scanResult != null)
            {
                unusedKeys = scanResult.Unused?.ToHashSet() ?? new HashSet<string>();
                missingFromResources = scanResult.Missing?.ToHashSet() ?? new HashSet<string>();
                ScanCache.CacheScanResult(scanResult);
            }
            await PerformSearchAsync();
            NotificationService.Notify(NotificationSeverity.Success, "Scan Complete", "Code scan finished successfully");
        }
        catch (Exception ex)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Scan Failed", ex.Message);
        }
        finally
        {
            isScanning = false;
        }
    }

    private void OnSearchInput(ChangeEventArgs e)
    {
        searchFilter = e.Value?.ToString() ?? "";
        _searchDebounceToken?.Cancel();
        _searchDebounceToken = new CancellationTokenSource();
        _ = DebounceSearchAsync(_searchDebounceToken.Token);
    }

    private async Task DebounceSearchAsync(CancellationToken cancellationToken)
    {
        try
        {
            await Task.Delay(SearchDebounceMs, cancellationToken);
            if (!cancellationToken.IsCancellationRequested)
            {
                await PerformSearchAsync();
            }
        }
        catch (TaskCanceledException) { }
    }

    private void ClearSearch()
    {
        searchFilter = "";
        _searchDebounceToken?.Cancel();
        _ = PerformSearchAsync();
    }

    private void OnFilterModeChanged()
    {
        _searchDebounceToken?.Cancel();
        _ = PerformSearchAsync();
    }

    private async Task PerformSearchAsync()
    {
        if (keys == null) return;

        var statusFilters = new List<string>();
        if (filterMissing) statusFilters.Add("missing");
        if (filterExtra) statusFilters.Add("extra");
        if (filterDuplicates) statusFilters.Add("duplicates");

        string filterMode = "substring";
        if (useRegex) filterMode = "regex";
        else if (useWildcard) filterMode = "wildcard";

        try
        {
            var request = new SearchRequest
            {
                Pattern = searchFilter,
                FilterMode = filterMode,
                CaseSensitive = caseSensitive,
                StatusFilters = statusFilters.Any() ? statusFilters : null
            };

            var response = await SearchApi.SearchAsync(request);
            if (response != null)
            {
                filteredKeys = response.Results;
                ApplyLocalFilters();
            }
        }
        catch
        {
            filteredKeys = keys.OrderBy(k => k.Key).ToList();
        }

        StateHasChanged();
    }

    private void ApplyLocalFilters()
    {
        if (filterUnused && unusedKeys.Any())
        {
            filteredKeys = filteredKeys.Where(k => unusedKeys.Contains(k.Key)).ToList();
        }
        StateHasChanged();
    }

    private string GetSearchPlaceholder()
    {
        if (useRegex) return "Search (regex)...";
        if (useWildcard) return "Search (wildcards * ?)...";
        return "Search keys and values...";
    }

    private void ToggleLanguage(string langCode, bool visible)
    {
        if (visible) visibleLanguages.Add(langCode);
        else visibleLanguages.Remove(langCode);
    }

    private void OnRowRender(RowRenderEventArgs<ResourceKeyInfo> args)
    {
        var status = GetKeyStatus(args.Data);
        if (!string.IsNullOrEmpty(status.RowClass))
        {
            args.Attributes.Add("class", status.RowClass);
        }
    }

    private KeyStatus GetKeyStatus(ResourceKeyInfo key)
    {
        var status = new KeyStatus();

        if (key.HasDuplicates)
        {
            status.Icons.Add(new StatusIcon("D", BadgeStyle.Warning, "Duplicate key"));
        }

        if (missingTranslationKeys.Contains(key.Key))
        {
            status.Icons.Add(new StatusIcon("M", BadgeStyle.Danger, "Missing translations"));
        }

        if (extraKeys.Contains(key.Key))
        {
            status.Icons.Add(new StatusIcon("E", BadgeStyle.Info, "Extra key"));
        }

        if (unusedKeys.Contains(key.Key))
        {
            status.Icons.Add(new StatusIcon("U", BadgeStyle.Light, "Unused in code"));
        }

        return status;
    }

    private async Task DeleteKey(string key)
    {
        var confirmed = await DialogService.Confirm(
            $"Are you sure you want to delete the key <strong>{key}</strong>?<br/><br/>This will remove the key from all language files.",
            "Confirm Delete",
            new ConfirmOptions { OkButtonText = "Delete", CancelButtonText = "Cancel" });

        if (confirmed == true)
        {
            try
            {
                await ResourceApi.DeleteKeyAsync(key);
                NotificationService.Notify(NotificationSeverity.Success, "Deleted", $"Key '{key}' deleted successfully");
                await LoadResources();
            }
            catch (Exception ex)
            {
                NotificationService.Notify(NotificationSeverity.Error, "Delete Failed", ex.Message);
            }
        }
    }

    private async Task ViewReferences(string key)
    {
        List<CodeReference>? refs = null;
        string? error = null;

        if (ScanCache.TryGetReferences(key, out var cachedRefs))
        {
            refs = cachedRefs ?? new List<CodeReference>();
        }
        else
        {
            try
            {
                refs = await ScanApi.GetReferencesAsync(key) ?? new List<CodeReference>();
            }
            catch (Exception ex)
            {
                error = ex.Message;
            }
        }

        if (error != null)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Scan Failed", error);
            return;
        }

        if (refs == null || refs.Count == 0)
        {
            NotificationService.Notify(NotificationSeverity.Warning, "No References", $"No code references found for '{key}'. This key may be unused.");
        }
        else
        {
            var message = $"Found {refs.Count} reference(s):\n" +
                         string.Join("\n", refs.Take(10).Select(r => $"• {GetFileName(r.File)}:{r.Line}"));
            if (refs.Count > 10) message += $"\n... and {refs.Count - 10} more";

            await DialogService.Alert(message, $"Code References: {key}");
        }
    }

    private string GetFileName(string filePath)
    {
        if (string.IsNullOrEmpty(filePath)) return filePath;
        var lastSlash = filePath.LastIndexOfAny(new[] { '/', '\\' });
        return lastSlash >= 0 ? filePath.Substring(lastSlash + 1) : filePath;
    }

    // Multi-select methods
    private void ToggleKeySelection(string key, bool selected)
    {
        if (selected) selectedKeys.Add(key);
        else selectedKeys.Remove(key);
    }

    private bool IsAllVisibleSelected()
    {
        if (!filteredKeys.Any()) return false;
        var visibleKeys = filteredKeys.Take(50).Select(k => k.Key).ToList();
        return visibleKeys.All(k => selectedKeys.Contains(k));
    }

    private void ToggleSelectAll(bool selectAll)
    {
        if (selectAll)
        {
            foreach (var key in filteredKeys.Take(50))
            {
                selectedKeys.Add(key.Key);
            }
        }
        else
        {
            var visibleKeys = filteredKeys.Take(50).Select(k => k.Key).ToHashSet();
            selectedKeys.RemoveWhere(k => visibleKeys.Contains(k));
        }
    }

    private void ClearSelection() => selectedKeys.Clear();

    private void BulkTranslate()
    {
        if (!selectedKeys.Any()) return;
        var keysParam = string.Join(",", selectedKeys.Select(Uri.EscapeDataString));
        Navigation.NavigateTo($"/translation?keys={keysParam}");
    }

    private async Task BulkDelete()
    {
        if (!selectedKeys.Any()) return;

        var confirmed = await DialogService.Confirm(
            $"Are you sure you want to delete <strong>{selectedKeys.Count}</strong> selected keys?<br/><br/>This will remove the keys from all language files.",
            "Confirm Bulk Delete",
            new ConfirmOptions { OkButtonText = "Delete All", CancelButtonText = "Cancel" });

        if (confirmed == true)
        {
            var keysToDelete = selectedKeys.ToList();
            var deleted = 0;

            foreach (var key in keysToDelete)
            {
                try
                {
                    await ResourceApi.DeleteKeyAsync(key);
                    deleted++;
                }
                catch { }
            }

            selectedKeys.Clear();
            NotificationService.Notify(NotificationSeverity.Success, "Bulk Delete", $"Deleted {deleted} of {keysToDelete.Count} keys");
            await LoadResources();
        }
    }

    private class KeyStatus
    {
        public List<StatusIcon> Icons { get; set; } = new();
        public string RowClass { get; set; } = "";
    }

    private class StatusIcon
    {
        public string Symbol { get; set; }
        public BadgeStyle BadgeStyle { get; set; }
        public string Title { get; set; }

        public StatusIcon(string symbol, BadgeStyle style, string title)
        {
            Symbol = symbol;
            BadgeStyle = style;
            Title = title;
        }
    }
}
