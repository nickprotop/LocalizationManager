@page "/editor/merge-duplicates"
@using LocalizationManager.Services
@using LocalizationManager.Models.Api
@inject MergeDuplicatesApiClient MergeApi
@inject ResourceApiClient ResourceApi
@inject NavigationManager Navigation
@inject NotificationService NotificationService
@inject DialogService DialogService

<PageTitle>Merge Duplicates - Localization Manager</PageTitle>

<RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" class="rz-mb-4">
    <RadzenButton Icon="arrow_back" ButtonStyle="ButtonStyle.Light" Click="@(() => Navigation.NavigateTo("/editor"))" />
    <RadzenText TextStyle="TextStyle.H4">Merge Duplicate Keys</RadzenText>
</RadzenStack>

@if (errorMessage != null)
{
    <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" Shade="Shade.Dark" AllowClose="true" Close="@(() => errorMessage = null)" class="rz-mb-4">
        <strong>Error:</strong> @errorMessage
    </RadzenAlert>
}

@if (successMessage != null)
{
    <RadzenAlert AlertStyle="AlertStyle.Success" Variant="Variant.Flat" Shade="Shade.Dark" AllowClose="true" Close="@(() => successMessage = null)" class="rz-mb-4">
        @successMessage
        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" class="rz-mt-2">
            <RadzenButton Text="Refresh" Size="ButtonSize.Small" Click="@LoadDuplicates" />
            <RadzenButton Text="Back to Editor" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" Click="@(() => Navigation.NavigateTo("/editor"))" />
        </RadzenStack>
    </RadzenAlert>
}

@if (isLoading)
{
    <RadzenCard>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
            <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Small" />
            <RadzenText>Loading duplicates...</RadzenText>
        </RadzenStack>
    </RadzenCard>
}
else if (duplicates == null || duplicates.Count == 0)
{
    <RadzenAlert AlertStyle="AlertStyle.Success" Variant="Variant.Flat" Shade="Shade.Dark" AllowClose="false">
        <RadzenText TextStyle="TextStyle.H6">No Duplicates Found</RadzenText>
        <RadzenText>All keys in your resource files are unique.</RadzenText>
        <RadzenButton Text="Back to Editor" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" class="rz-mt-2"
                     Click="@(() => Navigation.NavigateTo("/editor"))" />
    </RadzenAlert>
}
else
{
    <RadzenCard class="rz-mb-4">
        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center">
            <RadzenText><strong>@duplicates.Count</strong> duplicate key(s) found</RadzenText>
            <RadzenButton Text="@(isMerging ? "Merging..." : "Merge All (Keep First)")"
                         Icon="merge_type" ButtonStyle="ButtonStyle.Danger"
                         Click="@MergeAllDuplicates" Disabled="@isMerging" IsBusy="@isMerging" />
        </RadzenStack>
    </RadzenCard>

    @foreach (var dup in duplicates)
    {
        <RadzenCard class="rz-mb-4">
            <RadzenStack Gap="1rem">
                <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center">
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                        <RadzenBadge BadgeStyle="BadgeStyle.Warning" Text="D" />
                        <code class="key-name">@dup.Key</code>
                    </RadzenStack>
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                        <RadzenBadge BadgeStyle="BadgeStyle.Warning" Text="@($"{dup.OccurrenceCount} occurrences")" />
                        <RadzenButton Text="Merge (Keep First)" Size="ButtonSize.Small"
                                     Click="@(() => MergeSingleKey(dup.Key))" Disabled="@isMerging" />
                    </RadzenStack>
                </RadzenStack>

                @if (expandedKeys.Contains(dup.Key))
                {
                    <RadzenButton Text="Hide Details" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light"
                                 Click="@(() => ToggleExpand(dup.Key))" />

                    @foreach (var langValues in dup.ValuesByLanguage)
                    {
                        <RadzenFieldset Text="@langValues.Key">
                            @if (langValues.Value.Count > 1)
                            {
                                @for (int i = 0; i < langValues.Value.Count; i++)
                                {
                                    var index = i + 1;
                                    var value = langValues.Value[i];
                                    var isFirst = i == 0;
                                    <RadzenCard class="rz-mb-2" Style="@(isFirst ? "border-left: 3px solid var(--rz-success);" : "border-left: 3px solid var(--rz-danger);")">
                                        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center">
                                            <RadzenText>Occurrence @index</RadzenText>
                                            @if (isFirst)
                                            {
                                                <RadzenBadge BadgeStyle="BadgeStyle.Success" Text="Will Keep" />
                                            }
                                            else
                                            {
                                                <RadzenBadge BadgeStyle="BadgeStyle.Danger" Text="Will Remove" />
                                            }
                                        </RadzenStack>
                                        <RadzenText class="rz-mt-2">
                                            @if (string.IsNullOrEmpty(value))
                                            {
                                                <em class="rz-color-secondary">(empty)</em>
                                            }
                                            else
                                            {
                                                @value
                                            }
                                        </RadzenText>
                                    </RadzenCard>
                                }
                            }
                            else
                            {
                                <RadzenText class="rz-color-secondary">@(langValues.Value.FirstOrDefault() ?? "(empty)")</RadzenText>
                            }
                        </RadzenFieldset>
                    }
                }
                else
                {
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                        <RadzenButton Text="Show Details" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light"
                                     Click="@(() => ToggleExpand(dup.Key))" />
                        <RadzenText class="rz-color-secondary">
                            Languages: @string.Join(", ", dup.ValuesByLanguage.Keys)
                        </RadzenText>
                    </RadzenStack>
                }
            </RadzenStack>
        </RadzenCard>
    }
}

@code {
    private List<DuplicateKeyInfo>? duplicates;
    private HashSet<string> expandedKeys = new();
    private bool isLoading = true;
    private bool isMerging = false;
    private string? errorMessage;
    private string? successMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadDuplicates();
    }

    private async Task LoadDuplicates()
    {
        isLoading = true;
        errorMessage = null;
        successMessage = null;

        try
        {
            var response = await MergeApi.ListDuplicatesAsync();
            duplicates = response?.DuplicateKeys ?? new List<DuplicateKeyInfo>();
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to load duplicates: {ex.Message}";
            duplicates = new List<DuplicateKeyInfo>();
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ToggleExpand(string key)
    {
        if (expandedKeys.Contains(key))
        {
            expandedKeys.Remove(key);
        }
        else
        {
            expandedKeys.Add(key);
        }
    }

    private async Task MergeSingleKey(string key)
    {
        isMerging = true;
        errorMessage = null;
        successMessage = null;

        try
        {
            var result = await MergeApi.MergeKeyAsync(key);
            if (result?.Success == true)
            {
                successMessage = result.Message ?? $"Successfully merged '{key}'";
                NotificationService.Notify(NotificationSeverity.Success, "Merged", successMessage);
                await LoadDuplicates();
            }
            else
            {
                errorMessage = "Merge operation failed.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to merge key: {ex.Message}";
            NotificationService.Notify(NotificationSeverity.Error, "Merge Failed", ex.Message);
        }
        finally
        {
            isMerging = false;
        }
    }

    private async Task MergeAllDuplicates()
    {
        if (duplicates == null || duplicates.Count == 0) return;

        var confirmed = await DialogService.Confirm(
            $"Are you sure you want to merge all <strong>{duplicates.Count}</strong> duplicate keys?<br/><br/>This will keep the first occurrence and remove duplicates.",
            "Confirm Merge All",
            new ConfirmOptions { OkButtonText = "Merge All", CancelButtonText = "Cancel" });

        if (confirmed != true) return;

        isMerging = true;
        errorMessage = null;
        successMessage = null;

        try
        {
            var result = await MergeApi.MergeAllAsync();
            if (result?.Success == true)
            {
                successMessage = result.Message ?? $"Successfully merged {result.MergedCount} duplicate key(s)";
                NotificationService.Notify(NotificationSeverity.Success, "Merged All", successMessage);
                await LoadDuplicates();
            }
            else
            {
                errorMessage = "Merge operation failed.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to merge duplicates: {ex.Message}";
            NotificationService.Notify(NotificationSeverity.Error, "Merge Failed", ex.Message);
        }
        finally
        {
            isMerging = false;
        }
    }
}
