@page "/settings"
@using LocalizationManager.Services
@using LocalizationManager.Models.Api
@inject ConfigurationApiClient ConfigApi
@inject LanguageApiClient LanguageApi
@inject DialogService DialogService
@inject NotificationService NotificationService

<PageTitle>Settings - Localization Manager</PageTitle>

<RadzenText TextStyle="TextStyle.H4" class="rz-mb-4">Settings</RadzenText>

@if (isLoading)
{
    <RadzenCard>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
            <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Small" />
            <RadzenText>Loading settings...</RadzenText>
        </RadzenStack>
    </RadzenCard>
}
else if (errorMessage != null)
{
    <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" Shade="Shade.Dark" AllowClose="true" Close="@(() => errorMessage = null)">
        <strong>Error:</strong> @errorMessage
    </RadzenAlert>
}
else
{
    <RadzenTabs>
        <Tabs>
            <!-- Languages Tab -->
            <RadzenTabsItem Text="Languages">
                <RadzenCard class="rz-mt-4">
                    <RadzenStack Gap="1rem">
                        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center">
                            <RadzenText TextStyle="TextStyle.H6">Language Management</RadzenText>
                            <RadzenButton Text="Add Language" Icon="add" Size="ButtonSize.Small" Click="@ShowAddLanguageDialog" />
                        </RadzenStack>

                        @if (languages != null)
                        {
                            <RadzenDataGrid Data="@languages.Languages.OrderByDescending(l => l.IsDefault)" TItem="LanguageInfo"
                                           AllowSorting="true">
                                <Columns>
                                    <RadzenDataGridColumn TItem="LanguageInfo" Property="DisplayName" Title="Language" Width="200px">
                                        <Template Context="lang">
                                            @lang.DisplayName
                                            @if (lang.IsDefault)
                                            {
                                                <RadzenBadge BadgeStyle="BadgeStyle.Info" Text="Default" class="rz-ml-2" />
                                            }
                                        </Template>
                                    </RadzenDataGridColumn>
                                    <RadzenDataGridColumn TItem="LanguageInfo" Property="Code" Title="Code" Width="100px">
                                        <Template Context="lang">
                                            <code>@(lang.Code ?? "default")</code>
                                        </Template>
                                    </RadzenDataGridColumn>
                                    <RadzenDataGridColumn TItem="LanguageInfo" Property="FilePath" Title="File" Width="200px">
                                        <Template Context="lang">
                                            <RadzenText TextStyle="TextStyle.Caption">@Path.GetFileName(lang.FilePath)</RadzenText>
                                        </Template>
                                    </RadzenDataGridColumn>
                                    <RadzenDataGridColumn TItem="LanguageInfo" Title="Keys" Width="120px" TextAlign="TextAlign.Center">
                                        <Template Context="lang">
                                            @lang.TranslatedKeys / @lang.TotalKeys
                                        </Template>
                                    </RadzenDataGridColumn>
                                    <RadzenDataGridColumn TItem="LanguageInfo" Property="Coverage" Title="Coverage" Width="120px">
                                        <Template Context="lang">
                                            <RadzenStack Gap="0.25rem">
                                                <RadzenProgressBar Value="@lang.Coverage" Max="100" ShowValue="false" Style="height: 6px;" />
                                                <RadzenText TextStyle="TextStyle.Caption" class="@(lang.Coverage == 100 ? "rz-color-success" : lang.Coverage < 50 ? "rz-color-danger" : "")">
                                                    @lang.Coverage%
                                                </RadzenText>
                                            </RadzenStack>
                                        </Template>
                                    </RadzenDataGridColumn>
                                    <RadzenDataGridColumn TItem="LanguageInfo" Title="Actions" Width="100px" Sortable="false" TextAlign="TextAlign.Center">
                                        <Template Context="lang">
                                            @if (!lang.IsDefault)
                                            {
                                                <RadzenButton Icon="delete" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Danger"
                                                             Click="@(() => ConfirmRemoveLanguage(lang))" title="Remove language" />
                                            }
                                        </Template>
                                    </RadzenDataGridColumn>
                                </Columns>
                            </RadzenDataGrid>
                        }
                    </RadzenStack>
                </RadzenCard>
            </RadzenTabsItem>

            <!-- Configuration Tab -->
            <RadzenTabsItem Text="Configuration">
                <RadzenCard class="rz-mt-4">
                    <RadzenStack Gap="1rem">
                        <RadzenText TextStyle="TextStyle.H6">Configuration File (lrm.json)</RadzenText>
                        <RadzenText TextStyle="TextStyle.Body2" class="rz-color-secondary">
                            View and manage your project's localization configuration.
                        </RadzenText>

                        @if (config != null && config.Configuration != null)
                        {
                            @if (!isEditingConfig)
                            {
                                <RadzenTextArea Value="@System.Text.Json.JsonSerializer.Serialize(config.Configuration, new System.Text.Json.JsonSerializerOptions { WriteIndented = true })"
                                               ReadOnly="true" Rows="15" Style="width: 100%; font-family: monospace; font-size: 0.85rem;" />

                                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
                                    <RadzenButton Text="Validate" Icon="check_circle" ButtonStyle="ButtonStyle.Secondary" Click="@ValidateConfiguration" />
                                    <RadzenButton Text="Edit" Icon="edit" Click="@StartEditingConfig" />
                                </RadzenStack>
                            }
                            else
                            {
                                <RadzenStack Gap="0.5rem">
                                    <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
                                        <RadzenButton Text="Current Values" Size="ButtonSize.Small"
                                                     ButtonStyle="@(showSchemaView ? ButtonStyle.Light : ButtonStyle.Primary)"
                                                     Click="@(() => ToggleSchemaView(false))" />
                                        <RadzenButton Text="With Schema (All Options)" Size="ButtonSize.Small"
                                                     ButtonStyle="@(showSchemaView ? ButtonStyle.Primary : ButtonStyle.Light)"
                                                     Click="@(() => ToggleSchemaView(true))" />
                                    </RadzenStack>

                                    <RadzenTextArea @bind-Value="@editedConfigJson" Rows="20"
                                                   Style="width: 100%; font-family: monospace; font-size: 0.85rem;" />

                                    @if (showSchemaView)
                                    {
                                        <RadzenText TextStyle="TextStyle.Caption" class="rz-color-secondary">
                                            Showing all available configuration options with inline documentation.
                                            Lines starting with // are commented out and won't be saved.
                                        </RadzenText>
                                    }
                                </RadzenStack>

                                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
                                    <RadzenButton Text="@(isSavingConfig ? "Saving..." : "Save Configuration")" Icon="save"
                                                 Click="@SaveConfiguration" Disabled="@isSavingConfig" IsBusy="@isSavingConfig" />
                                    <RadzenButton Text="Cancel" ButtonStyle="ButtonStyle.Light" Click="@CancelEditingConfig" />
                                </RadzenStack>
                            }
                        }
                        else
                        {
                            <RadzenAlert AlertStyle="AlertStyle.Info" Variant="Variant.Flat" Shade="Shade.Dark" AllowClose="false">
                                No configuration file found.
                            </RadzenAlert>
                            <RadzenButton Text="Create Default Configuration" Icon="add" Click="@CreateDefaultConfig" />
                        }
                    </RadzenStack>
                </RadzenCard>

                @if (configValidation != null)
                {
                    <RadzenAlert AlertStyle="@(configValidation.IsValid ? AlertStyle.Success : AlertStyle.Danger)"
                                Variant="Variant.Flat" Shade="Shade.Dark" AllowClose="true" Close="@(() => configValidation = null)" class="rz-mt-4">
                        <RadzenText TextStyle="TextStyle.H6" class="rz-mb-2">Configuration Validation</RadzenText>
                        @if (configValidation.IsValid)
                        {
                            <RadzenText>Configuration is valid.</RadzenText>
                        }
                        else
                        {
                            <RadzenText>Configuration has errors:</RadzenText>
                            <ul>
                                @foreach (var error in configValidation.Errors ?? new List<string>())
                                {
                                    <li>@error</li>
                                }
                            </ul>
                        }
                    </RadzenAlert>
                }
            </RadzenTabsItem>
        </Tabs>
    </RadzenTabs>
}

@code {
    private LanguagesResponse? languages;
    private ConfigurationResponse? config;
    private ConfigValidationResponse? configValidation;
    private SchemaEnrichedConfigResponse? schemaEnrichedConfig;
    private bool isLoading = true;
    private bool isAddingLanguage = false;
    private bool isEditingConfig = false;
    private bool isSavingConfig = false;
    private bool showSchemaView = true;
    private string? errorMessage;
    private string newLanguageCode = "";
    private bool createEmpty = false;
    private string editedConfigJson = string.Empty;
    private string currentValuesJson = string.Empty;
    private string schemaEnrichedJson = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            languages = await LanguageApi.GetLanguagesAsync();
            config = await ConfigApi.GetConfigurationAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to load settings: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ShowAddLanguageDialog()
    {
        newLanguageCode = "";
        createEmpty = false;

        var result = await DialogService.OpenAsync("Add New Language", ds =>
            @<RadzenStack Gap="1rem">
                <RadzenFormField Text="Culture Code (e.g., fr, de, es, zh-CN)" Style="width: 100%;">
                    <RadzenTextBox @bind-Value="@newLanguageCode" Style="width: 100%;" />
                </RadzenFormField>

                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.25rem">
                    <RadzenCheckBox @bind-Value="@createEmpty" Name="cbCreateEmpty" />
                    <RadzenLabel Text="Create empty language file (no pre-filled keys)" Component="cbCreateEmpty" />
                </RadzenStack>

                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" JustifyContent="JustifyContent.End">
                    <RadzenButton Text="Cancel" ButtonStyle="ButtonStyle.Light" Click="@(() => ds.Close(false))" />
                    <RadzenButton Text="Add Language" Click="@(() => ds.Close(true))"
                                 Disabled="@string.IsNullOrWhiteSpace(newLanguageCode)" />
                </RadzenStack>
            </RadzenStack>,
            new DialogOptions { Width = "400px" });

        if (result == true && !string.IsNullOrWhiteSpace(newLanguageCode))
        {
            await AddLanguage();
        }
    }

    private async Task AddLanguage()
    {
        isAddingLanguage = true;
        errorMessage = null;

        try
        {
            var request = new AddLanguageRequest
            {
                CultureCode = newLanguageCode.Trim(),
                Empty = createEmpty
            };

            var result = await LanguageApi.AddLanguageAsync(request);
            if (result?.Success == true)
            {
                NotificationService.Notify(NotificationSeverity.Success, "Language Added", $"Added {result.DisplayName}");
                await LoadData();
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to add language: {ex.Message}";
            NotificationService.Notify(NotificationSeverity.Error, "Failed to Add Language", ex.Message);
        }
        finally
        {
            isAddingLanguage = false;
        }
    }

    private async Task ConfirmRemoveLanguage(LanguageInfo lang)
    {
        var confirmed = await DialogService.Confirm(
            $"Are you sure you want to remove <strong>{lang.DisplayName}</strong>?<br/><br/>This will delete the language file.",
            "Confirm Remove Language",
            new ConfirmOptions { OkButtonText = "Remove", CancelButtonText = "Cancel" });

        if (confirmed == true)
        {
            await RemoveLanguage(lang.Code!);
        }
    }

    private async Task RemoveLanguage(string cultureCode)
    {
        errorMessage = null;

        try
        {
            var result = await LanguageApi.RemoveLanguageAsync(cultureCode);
            if (result?.Success == true)
            {
                NotificationService.Notify(NotificationSeverity.Success, "Language Removed", result.Message);
                await LoadData();
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to remove language: {ex.Message}";
            NotificationService.Notify(NotificationSeverity.Error, "Failed to Remove Language", ex.Message);
        }
    }

    private async Task ValidateConfiguration()
    {
        errorMessage = null;
        configValidation = null;

        try
        {
            configValidation = await ConfigApi.ValidateConfigurationAsync();

            if (configValidation.IsValid)
            {
                NotificationService.Notify(NotificationSeverity.Success, "Valid", "Configuration is valid");
            }
            else
            {
                NotificationService.Notify(NotificationSeverity.Warning, "Invalid", $"{configValidation.Errors?.Count ?? 0} error(s) found");
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to validate configuration: {ex.Message}";
        }
    }

    private async Task CreateDefaultConfig()
    {
        errorMessage = null;

        try
        {
            var result = await ConfigApi.CreateConfigurationAsync();
            if (result?.Success == true)
            {
                NotificationService.Notify(NotificationSeverity.Success, "Created", result.Message ?? "Created default configuration file");
                await LoadData();
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to create configuration: {ex.Message}";
            NotificationService.Notify(NotificationSeverity.Error, "Failed", ex.Message);
        }
    }

    private async Task StartEditingConfig()
    {
        if (config?.Configuration != null)
        {
            currentValuesJson = System.Text.Json.JsonSerializer.Serialize(
                config.Configuration,
                new System.Text.Json.JsonSerializerOptions { WriteIndented = true }
            );

            try
            {
                schemaEnrichedConfig = await ConfigApi.GetSchemaEnrichedConfigAsync();
                schemaEnrichedJson = schemaEnrichedConfig?.EnrichedJson ?? currentValuesJson;
            }
            catch (Exception)
            {
                schemaEnrichedJson = currentValuesJson;
            }

            showSchemaView = true;
            editedConfigJson = schemaEnrichedJson;
            isEditingConfig = true;
            errorMessage = null;
        }
    }

    private void ToggleSchemaView(bool showSchema)
    {
        showSchemaView = showSchema;
        editedConfigJson = showSchema ? schemaEnrichedJson : currentValuesJson;
    }

    private void CancelEditingConfig()
    {
        isEditingConfig = false;
        editedConfigJson = string.Empty;
    }

    private async Task SaveConfiguration()
    {
        isSavingConfig = true;
        errorMessage = null;

        try
        {
            var cleanedJson = StripJsonComments(editedConfigJson);

            var configModel = System.Text.Json.JsonSerializer.Deserialize<LocalizationManager.Core.Configuration.ConfigurationModel>(
                cleanedJson,
                new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true }
            );

            if (configModel == null)
            {
                errorMessage = "Failed to parse configuration JSON";
                return;
            }

            var result = await ConfigApi.UpdateConfigurationAsync(configModel);
            if (result?.Success == true)
            {
                NotificationService.Notify(NotificationSeverity.Success, "Saved", result.Message ?? "Configuration updated successfully");
                isEditingConfig = false;
                await LoadData();
            }
        }
        catch (System.Text.Json.JsonException ex)
        {
            errorMessage = $"Invalid JSON: {ex.Message}";
            NotificationService.Notify(NotificationSeverity.Error, "Invalid JSON", ex.Message);
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to save configuration: {ex.Message}";
            NotificationService.Notify(NotificationSeverity.Error, "Save Failed", ex.Message);
        }
        finally
        {
            isSavingConfig = false;
        }
    }

    private string StripJsonComments(string jsonWithComments)
    {
        if (string.IsNullOrWhiteSpace(jsonWithComments))
            return jsonWithComments;

        var lines = jsonWithComments.Split('\n');
        var cleanedLines = new System.Collections.Generic.List<string>();

        foreach (var line in lines)
        {
            var trimmedLine = line.TrimStart();

            if (trimmedLine.StartsWith("//"))
                continue;

            var commentIndex = line.IndexOf("//");
            if (commentIndex > 0)
            {
                var beforeComment = line.Substring(0, commentIndex);
                var quoteCount = beforeComment.Count(c => c == '"');

                if (quoteCount % 2 == 0)
                {
                    cleanedLines.Add(beforeComment.TrimEnd());
                    continue;
                }
            }

            cleanedLines.Add(line);
        }

        return string.Join('\n', cleanedLines);
    }
}
