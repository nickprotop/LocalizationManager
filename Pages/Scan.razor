@page "/scan"
@using LocalizationManager.Services
@using LocalizationManager.Models.Api
@inject ScanApiClient ScanApi
@inject ScanCacheService ScanCache
@inject DialogService DialogService
@inject NotificationService NotificationService

<PageTitle>Code Scanner - Localization Manager</PageTitle>

<RadzenText TextStyle="TextStyle.H4" class="rz-mb-4">Code Scanner</RadzenText>

<RadzenCard class="rz-mb-4">
    <RadzenText TextStyle="TextStyle.H6" class="rz-mb-2">Scan Source Code</RadzenText>
    <RadzenText TextStyle="TextStyle.Body2" class="rz-mb-4 rz-color-secondary">
        Scan your codebase to find localization key usage and detect unused or missing keys.
    </RadzenText>

    <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.Center" Wrap="FlexWrap.Wrap">
        <RadzenButton Text="@(isScanning ? "Scanning..." : "Run Scan")" Icon="search"
                     Click="@RunScan" Disabled="@isScanning" IsBusy="@isScanning" />
        <RadzenButton Text="Show Unused Keys" Icon="delete_sweep" ButtonStyle="ButtonStyle.Secondary" Click="@LoadUnusedKeys" />
        <RadzenButton Text="Show Missing Keys" Icon="error_outline" ButtonStyle="ButtonStyle.Secondary" Click="@LoadMissingKeys" />
        @if (ScanCache.HasCachedScan)
        {
            <RadzenButton Text="Clear Cache" Icon="clear" ButtonStyle="ButtonStyle.Light" Click="@ClearCache" />
        }
    </RadzenStack>

    @if (ScanCache.HasCachedScan && ScanCache.ScanTimestamp.HasValue)
    {
        <RadzenText TextStyle="TextStyle.Caption" class="rz-color-secondary rz-mt-2">
            Last scan: @ScanCache.ScanTimestamp.Value.ToString("HH:mm:ss")
        </RadzenText>
    }
</RadzenCard>

@if (errorMessage != null)
{
    <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" Shade="Shade.Dark" AllowClose="true" Close="@(() => errorMessage = null)" class="rz-mb-4">
        <strong>Error:</strong> @errorMessage
    </RadzenAlert>
}

@if (scanResult != null)
{
    <!-- Summary Card -->
    <RadzenCard class="rz-mb-4">
        <RadzenText TextStyle="TextStyle.H6" class="rz-mb-4">Scan Results</RadzenText>
        <RadzenStack Orientation="Orientation.Horizontal" Gap="1.5rem" Wrap="FlexWrap.Wrap">
            <RadzenStack AlignItems="AlignItems.Center" Gap="0.25rem">
                <RadzenText TextStyle="TextStyle.H4" class="rz-color-primary">@scanResult.ScannedFiles</RadzenText>
                <RadzenText TextStyle="TextStyle.Caption">Files Scanned</RadzenText>
            </RadzenStack>
            <RadzenStack AlignItems="AlignItems.Center" Gap="0.25rem">
                <RadzenText TextStyle="TextStyle.H4" class="rz-color-primary">@scanResult.TotalReferences</RadzenText>
                <RadzenText TextStyle="TextStyle.Caption">References Found</RadzenText>
            </RadzenStack>
            <RadzenStack AlignItems="AlignItems.Center" Gap="0.25rem">
                <RadzenText TextStyle="TextStyle.H4" class="@(scanResult.UnusedKeysCount > 0 ? "rz-color-warning" : "rz-color-success")">@scanResult.UnusedKeysCount</RadzenText>
                <RadzenText TextStyle="TextStyle.Caption">Unused Keys</RadzenText>
            </RadzenStack>
            <RadzenStack AlignItems="AlignItems.Center" Gap="0.25rem">
                <RadzenText TextStyle="TextStyle.H4" class="@(scanResult.MissingKeysCount > 0 ? "rz-color-danger" : "rz-color-success")">@scanResult.MissingKeysCount</RadzenText>
                <RadzenText TextStyle="TextStyle.Caption">Missing Keys</RadzenText>
            </RadzenStack>
        </RadzenStack>
    </RadzenCard>

    <!-- Tabbed Results -->
    <RadzenCard class="rz-mb-4">
        <RadzenTabs>
            <Tabs>
                @if (scanResult.Unused.Any())
                {
                    <RadzenTabsItem Text="@($"Unused Keys ({scanResult.Unused.Count})")">
                        <RadzenText TextStyle="TextStyle.Body2" class="rz-mb-4 rz-color-secondary">
                            These keys exist in resource files but are not referenced in code:
                        </RadzenText>
                        <RadzenDataGrid Data="@scanResult.Unused" TItem="string"
                                       AllowSorting="true" AllowPaging="true" PageSize="20"
                                       PagerHorizontalAlign="HorizontalAlign.Center">
                            <Columns>
                                <RadzenDataGridColumn TItem="string" Title="Key">
                                    <Template Context="key">
                                        <code class="key-name rz-color-warning">@key</code>
                                    </Template>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="string" Title="Actions" Width="150px" Sortable="false" TextAlign="TextAlign.Center">
                                    <Template Context="key">
                                        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.25rem" JustifyContent="JustifyContent.Center">
                                            <RadzenButton Text="Edit" Icon="edit" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light"
                                                         Click="@(() => NavigateToKey(key))" />
                                            <RadzenButton Text="Refs" Icon="code" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light"
                                                         Click="@(() => ShowReferences(key))" />
                                        </RadzenStack>
                                    </Template>
                                </RadzenDataGridColumn>
                            </Columns>
                        </RadzenDataGrid>
                    </RadzenTabsItem>
                }

                @if (scanResult.Missing.Any())
                {
                    <RadzenTabsItem Text="@($"Missing Keys ({scanResult.Missing.Count})")">
                        <RadzenText TextStyle="TextStyle.Body2" class="rz-mb-4 rz-color-secondary">
                            These keys are referenced in code but don't exist in resource files:
                        </RadzenText>
                        <RadzenDataGrid Data="@scanResult.Missing" TItem="string"
                                       AllowSorting="true" AllowPaging="true" PageSize="20"
                                       PagerHorizontalAlign="HorizontalAlign.Center">
                            <Columns>
                                <RadzenDataGridColumn TItem="string" Title="Key">
                                    <Template Context="key">
                                        <code class="key-name rz-color-danger">@key</code>
                                    </Template>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="string" Title="Actions" Width="100px" Sortable="false" TextAlign="TextAlign.Center">
                                    <Template Context="key">
                                        <RadzenButton Text="Refs" Icon="code" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light"
                                                     Click="@(() => ShowReferences(key))" />
                                    </Template>
                                </RadzenDataGridColumn>
                            </Columns>
                        </RadzenDataGrid>
                    </RadzenTabsItem>
                }

                @if (scanResult.References?.Any() == true)
                {
                    <RadzenTabsItem Text="@($"All References ({scanResult.References.Count})")">
                        <RadzenText TextStyle="TextStyle.Body2" class="rz-mb-4 rz-color-secondary">
                            Key usage details sorted by reference count:
                        </RadzenText>
                        <RadzenDataGrid Data="@scanResult.References.OrderByDescending(x => x.ReferenceCount)" TItem="KeyReferenceInfo"
                                       AllowSorting="true" AllowPaging="true" PageSize="20"
                                       PagerHorizontalAlign="HorizontalAlign.Center">
                            <Columns>
                                <RadzenDataGridColumn TItem="KeyReferenceInfo" Property="Key" Title="Key">
                                    <Template Context="refInfo">
                                        <code class="key-name">@refInfo.Key</code>
                                    </Template>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="KeyReferenceInfo" Property="ReferenceCount" Title="Refs" Width="80px" TextAlign="TextAlign.Center">
                                    <Template Context="refInfo">
                                        <RadzenBadge BadgeStyle="BadgeStyle.Info" Text="@($"{refInfo.ReferenceCount}")" />
                                    </Template>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="KeyReferenceInfo" Title="Actions" Width="150px" Sortable="false" TextAlign="TextAlign.Center">
                                    <Template Context="refInfo">
                                        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.25rem" JustifyContent="JustifyContent.Center">
                                            <RadzenButton Text="Edit" Icon="edit" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light"
                                                         Click="@(() => NavigateToKey(refInfo.Key))" />
                                            <RadzenButton Text="Refs" Icon="code" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light"
                                                         Click="@(() => ShowReferences(refInfo.Key))" />
                                        </RadzenStack>
                                    </Template>
                                </RadzenDataGridColumn>
                            </Columns>
                        </RadzenDataGrid>
                    </RadzenTabsItem>
                }
            </Tabs>
        </RadzenTabs>
    </RadzenCard>
}

@if (unusedKeys != null && scanResult == null)
{
    <RadzenCard class="rz-mb-4">
        <RadzenText TextStyle="TextStyle.H6" class="rz-mb-4 rz-color-warning">
            Unused Keys (@unusedKeys.Count)
        </RadzenText>
        <RadzenText TextStyle="TextStyle.Body2" class="rz-mb-4 rz-color-secondary">
            These keys exist in resource files but are not referenced in code:
        </RadzenText>
        <RadzenDataGrid Data="@unusedKeys" TItem="string"
                       AllowSorting="true" AllowPaging="true" PageSize="25"
                       PagerHorizontalAlign="HorizontalAlign.Center">
            <Columns>
                <RadzenDataGridColumn TItem="string" Title="Key">
                    <Template Context="key">
                        <code class="key-name rz-color-warning">@key</code>
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="string" Title="Actions" Width="150px" Sortable="false" TextAlign="TextAlign.Center">
                    <Template Context="key">
                        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.25rem" JustifyContent="JustifyContent.Center">
                            <RadzenButton Text="Edit" Icon="edit" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light"
                                         Click="@(() => NavigateToKey(key))" />
                            <RadzenButton Text="Refs" Icon="code" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light"
                                         Click="@(() => ShowReferences(key))" />
                        </RadzenStack>
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    </RadzenCard>
}

@if (missingKeys != null && scanResult == null)
{
    <RadzenCard class="rz-mb-4">
        <RadzenText TextStyle="TextStyle.H6" class="rz-mb-4 rz-color-danger">
            Missing Keys (@missingKeys.Count)
        </RadzenText>
        <RadzenText TextStyle="TextStyle.Body2" class="rz-mb-4 rz-color-secondary">
            These keys are referenced in code but don't exist in resource files:
        </RadzenText>
        <RadzenDataGrid Data="@missingKeys" TItem="string"
                       AllowSorting="true" AllowPaging="true" PageSize="25"
                       PagerHorizontalAlign="HorizontalAlign.Center">
            <Columns>
                <RadzenDataGridColumn TItem="string" Title="Key">
                    <Template Context="key">
                        <code class="key-name rz-color-danger">@key</code>
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="string" Title="Actions" Width="100px" Sortable="false" TextAlign="TextAlign.Center">
                    <Template Context="key">
                        <RadzenButton Text="Refs" Icon="code" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light"
                                     Click="@(() => ShowReferences(key))" />
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    </RadzenCard>
}

@code {
    private ScanResponse? scanResult;
    private List<string>? unusedKeys;
    private List<string>? missingKeys;
    private List<CodeReference>? selectedKeyReferences;
    private string? selectedKeyName;
    private bool isScanning = false;
    private bool isLoadingReferences = false;
    private string? errorMessage;

    [Inject]
    private NavigationManager Navigation { get; set; } = default!;

    protected override void OnInitialized()
    {
        if (ScanCache.HasCachedScan)
        {
            scanResult = ScanCache.ScanResult;
        }
    }

    private async Task RunScan()
    {
        isScanning = true;
        errorMessage = null;
        scanResult = null;
        unusedKeys = null;
        missingKeys = null;
        selectedKeyReferences = null;

        try
        {
            scanResult = await ScanApi.ScanAsync();
            if (scanResult != null)
            {
                ScanCache.CacheScanResult(scanResult);
                NotificationService.Notify(NotificationSeverity.Success, "Scan Complete",
                    $"Found {scanResult.TotalReferences} references in {scanResult.ScannedFiles} files");
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Scan failed: {ex.Message}";
            NotificationService.Notify(NotificationSeverity.Error, "Scan Failed", ex.Message);
        }
        finally
        {
            isScanning = false;
        }
    }

    private async Task LoadUnusedKeys()
    {
        errorMessage = null;
        unusedKeys = null;
        missingKeys = null;
        scanResult = null;
        selectedKeyReferences = null;

        try
        {
            if (ScanCache.HasCachedScan)
            {
                unusedKeys = ScanCache.GetUnusedKeys();
            }
            else
            {
                unusedKeys = await ScanApi.GetUnusedKeysAsync();
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to load unused keys: {ex.Message}";
        }
    }

    private async Task LoadMissingKeys()
    {
        errorMessage = null;
        unusedKeys = null;
        missingKeys = null;
        scanResult = null;
        selectedKeyReferences = null;

        try
        {
            if (ScanCache.HasCachedScan)
            {
                missingKeys = ScanCache.GetMissingKeys();
            }
            else
            {
                missingKeys = await ScanApi.GetMissingKeysAsync();
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to load missing keys: {ex.Message}";
        }
    }

    private async Task ShowReferences(string keyName)
    {
        selectedKeyName = keyName;
        selectedKeyReferences = null;
        isLoadingReferences = true;
        errorMessage = null;

        try
        {
            if (ScanCache.TryGetReferences(keyName, out var cached))
            {
                selectedKeyReferences = cached ?? new List<CodeReference>();
            }
            else
            {
                selectedKeyReferences = await ScanApi.GetReferencesAsync(keyName) ?? new List<CodeReference>();
            }

            // Show references in dialog
            await DialogService.OpenAsync<ReferencesDialog>($"Code References: {keyName}",
                new Dictionary<string, object> { { "References", selectedKeyReferences }, { "KeyName", keyName } },
                new DialogOptions { Width = "800px", Height = "500px", Resizable = true, Draggable = true });
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to load references: {ex.Message}";
            NotificationService.Notify(NotificationSeverity.Error, "Failed to Load", ex.Message);
        }
        finally
        {
            isLoadingReferences = false;
        }
    }

    private void ClearCache()
    {
        ScanCache.Clear();
        scanResult = null;
        unusedKeys = null;
        missingKeys = null;
        selectedKeyReferences = null;
        NotificationService.Notify(NotificationSeverity.Info, "Cache Cleared", "Scan cache has been cleared");
    }

    private void NavigateToKey(string key)
    {
        Navigation.NavigateTo($"/editor/key/{Uri.EscapeDataString(key)}");
    }
}
