@page "/import"
@using LocalizationManager.Services
@using LocalizationManager.Models.Api
@inject ImportApiClient ImportApi
@inject NotificationService NotificationService

<PageTitle>Import - Localization Manager</PageTitle>

<RadzenText TextStyle="TextStyle.H4" class="rz-mb-4">Import Resources</RadzenText>

<RadzenCard class="rz-mb-4">
    <RadzenStack Gap="1rem">
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
            <RadzenIcon Icon="file_upload" />
            <RadzenText TextStyle="TextStyle.H6">Import from CSV</RadzenText>
        </RadzenStack>
        <RadzenText TextStyle="TextStyle.Body2" class="rz-color-secondary">
            Import resource keys and translations from CSV format. CSV should have columns: Key, [language codes], and optionally Comment.
        </RadzenText>

        <RadzenFormField Text="CSV Data" Style="width: 100%;">
            <RadzenTextArea @bind-Value="@csvData" Rows="12" Placeholder="Paste CSV content here&#10;Example:&#10;Key,en,fr,Comment&#10;Hello,Hello,Bonjour,Greeting message&#10;Goodbye,Goodbye,Au revoir," Style="width: 100%; font-family: monospace;" />
        </RadzenFormField>

        <RadzenStack Orientation="Orientation.Horizontal" Gap="1.5rem" Wrap="FlexWrap.Wrap">
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.25rem">
                <RadzenCheckBox @bind-Value="@updateExisting" Name="cbUpdateExisting" />
                <RadzenLabel Text="Update existing keys" Component="cbUpdateExisting" />
            </RadzenStack>

            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.25rem">
                <RadzenCheckBox @bind-Value="@dryRun" Name="cbDryRun" />
                <RadzenLabel Text="Dry run (preview without saving)" Component="cbDryRun" />
            </RadzenStack>
        </RadzenStack>

        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
            <RadzenButton Text="@(isImporting ? "Importing..." : "Import CSV")" Icon="file_upload"
                         Click="@ImportCsv" Disabled="@(isImporting || string.IsNullOrWhiteSpace(csvData))"
                         IsBusy="@isImporting" />
            <RadzenButton Text="Clear" Icon="clear" ButtonStyle="ButtonStyle.Light" Click="@ClearForm" />
        </RadzenStack>
    </RadzenStack>
</RadzenCard>

@if (errorMessage != null)
{
    <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" Shade="Shade.Dark" AllowClose="true" Close="@(() => errorMessage = null)" class="rz-mb-4">
        <strong>Error:</strong> @errorMessage
    </RadzenAlert>
}

@if (importResult != null)
{
    <RadzenAlert AlertStyle="@(importResult.Success ? AlertStyle.Success : AlertStyle.Warning)"
                Variant="Variant.Flat" Shade="Shade.Dark" AllowClose="false" class="rz-mb-4">
        <RadzenText TextStyle="TextStyle.H6" class="rz-mb-2">Import Results</RadzenText>
        <RadzenStack Orientation="Orientation.Horizontal" Gap="1.5rem" Wrap="FlexWrap.Wrap" class="rz-mb-2">
            <RadzenText><strong>Added:</strong> @importResult.AddedCount keys</RadzenText>
            <RadzenText><strong>Updated:</strong> @importResult.UpdatedCount keys</RadzenText>
            <RadzenText><strong>Skipped:</strong> @importResult.SkippedCount keys</RadzenText>
            <RadzenText><strong>Errors:</strong> @importResult.ErrorCount</RadzenText>
        </RadzenStack>
        @if (importResult.DryRun)
        {
            <RadzenText TextStyle="TextStyle.Caption" class="rz-color-secondary">
                <em>Dry run - no changes saved</em>
            </RadzenText>
        }
    </RadzenAlert>

    @if (importResult.AddedKeys?.Any() == true || importResult.UpdatedKeys?.Any() == true || importResult.Errors?.Any() == true)
    {
        <RadzenCard>
            <RadzenTabs>
                <Tabs>
                    @if (importResult.AddedKeys?.Any() == true)
                    {
                        <RadzenTabsItem Text="@($"Added ({importResult.AddedKeys.Count})")">
                            <RadzenDataGrid Data="@importResult.AddedKeys.Take(100)" TItem="string"
                                           AllowPaging="true" PageSize="20" PagerHorizontalAlign="HorizontalAlign.Center">
                                <Columns>
                                    <RadzenDataGridColumn TItem="string" Title="Key">
                                        <Template Context="key">
                                            <code class="key-name rz-color-success">@key</code>
                                        </Template>
                                    </RadzenDataGridColumn>
                                </Columns>
                            </RadzenDataGrid>
                            @if (importResult.AddedKeys.Count > 100)
                            {
                                <RadzenText TextStyle="TextStyle.Caption" class="rz-color-secondary rz-mt-2">
                                    Showing first 100 of @importResult.AddedKeys.Count keys
                                </RadzenText>
                            }
                        </RadzenTabsItem>
                    }

                    @if (importResult.UpdatedKeys?.Any() == true)
                    {
                        <RadzenTabsItem Text="@($"Updated ({importResult.UpdatedKeys.Count})")">
                            <RadzenDataGrid Data="@importResult.UpdatedKeys.Take(100)" TItem="string"
                                           AllowPaging="true" PageSize="20" PagerHorizontalAlign="HorizontalAlign.Center">
                                <Columns>
                                    <RadzenDataGridColumn TItem="string" Title="Key">
                                        <Template Context="key">
                                            <code class="key-name">@key</code>
                                        </Template>
                                    </RadzenDataGridColumn>
                                </Columns>
                            </RadzenDataGrid>
                            @if (importResult.UpdatedKeys.Count > 100)
                            {
                                <RadzenText TextStyle="TextStyle.Caption" class="rz-color-secondary rz-mt-2">
                                    Showing first 100 of @importResult.UpdatedKeys.Count keys
                                </RadzenText>
                            }
                        </RadzenTabsItem>
                    }

                    @if (importResult.Errors?.Any() == true)
                    {
                        <RadzenTabsItem Text="@($"Errors ({importResult.Errors.Count})")">
                            <RadzenDataGrid Data="@importResult.Errors.Take(50)" TItem="string"
                                           AllowPaging="true" PageSize="10" PagerHorizontalAlign="HorizontalAlign.Center">
                                <Columns>
                                    <RadzenDataGridColumn TItem="string" Title="Error">
                                        <Template Context="error">
                                            <RadzenText class="rz-color-danger">@error</RadzenText>
                                        </Template>
                                    </RadzenDataGridColumn>
                                </Columns>
                            </RadzenDataGrid>
                            @if (importResult.Errors.Count > 50)
                            {
                                <RadzenText TextStyle="TextStyle.Caption" class="rz-color-secondary rz-mt-2">
                                    Showing first 50 of @importResult.Errors.Count errors
                                </RadzenText>
                            }
                        </RadzenTabsItem>
                    }
                </Tabs>
            </RadzenTabs>
        </RadzenCard>
    }
}

@code {
    private string csvData = string.Empty;
    private bool updateExisting = true;
    private bool dryRun = false;
    private bool isImporting = false;
    private string? errorMessage;
    private ImportResult? importResult;

    private async Task ImportCsv()
    {
        isImporting = true;
        errorMessage = null;
        importResult = null;

        try
        {
            var request = new ImportCsvRequest
            {
                CsvData = csvData,
                UpdateExisting = updateExisting,
                DryRun = dryRun
            };

            importResult = await ImportApi.ImportFromCsvAsync(request);

            if (importResult.Success)
            {
                NotificationService.Notify(NotificationSeverity.Success, "Import Complete",
                    $"Added {importResult.AddedCount}, Updated {importResult.UpdatedCount}" + (dryRun ? " (dry run)" : ""));
            }
            else
            {
                NotificationService.Notify(NotificationSeverity.Warning, "Import Completed with Errors",
                    $"{importResult.ErrorCount} error(s) occurred");
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Import failed: {ex.Message}";
            NotificationService.Notify(NotificationSeverity.Error, "Import Failed", ex.Message);
        }
        finally
        {
            isImporting = false;
        }
    }

    private void ClearForm()
    {
        csvData = string.Empty;
        importResult = null;
        errorMessage = null;
    }
}
