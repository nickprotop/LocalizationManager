@page "/export"
@using LocalizationManager.Services
@using Microsoft.JSInterop
@inject ExportApiClient ExportApi
@inject IJSRuntime JSRuntime
@inject NotificationService NotificationService

<PageTitle>Export - Localization Manager</PageTitle>

<RadzenText TextStyle="TextStyle.H4" class="rz-mb-4">Export Resources</RadzenText>

<RadzenRow Gap="1rem">
    <RadzenColumn Size="12" SizeMD="6">
        <RadzenCard>
            <RadzenStack Gap="1rem">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                    <RadzenIcon Icon="code" />
                    <RadzenText TextStyle="TextStyle.H6">Export to JSON</RadzenText>
                </RadzenStack>
                <RadzenText TextStyle="TextStyle.Body2" class="rz-color-secondary">
                    Export all resources to JSON format for backup or integration purposes.
                </RadzenText>

                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.25rem">
                    <RadzenCheckBox @bind-Value="@includeCommentsJson" Name="cbJsonComments" />
                    <RadzenLabel Text="Include comments in export" Component="cbJsonComments" />
                </RadzenStack>

                <RadzenButton Text="@(isExportingJson ? "Exporting..." : "Export to JSON")" Icon="file_download"
                             Click="@ExportToJson" Disabled="@isExportingJson" IsBusy="@isExportingJson" />
            </RadzenStack>
        </RadzenCard>
    </RadzenColumn>

    <RadzenColumn Size="12" SizeMD="6">
        <RadzenCard>
            <RadzenStack Gap="1rem">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                    <RadzenIcon Icon="table_chart" />
                    <RadzenText TextStyle="TextStyle.H6">Export to CSV</RadzenText>
                </RadzenStack>
                <RadzenText TextStyle="TextStyle.Body2" class="rz-color-secondary">
                    Export all resources to CSV format for editing in spreadsheet applications.
                </RadzenText>

                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.25rem">
                    <RadzenCheckBox @bind-Value="@includeCommentsCsv" Name="cbCsvComments" />
                    <RadzenLabel Text="Include comments in export" Component="cbCsvComments" />
                </RadzenStack>

                <RadzenButton Text="@(isExportingCsv ? "Exporting..." : "Export to CSV")" Icon="file_download"
                             Click="@ExportToCsv" Disabled="@isExportingCsv" IsBusy="@isExportingCsv" />
            </RadzenStack>
        </RadzenCard>
    </RadzenColumn>
</RadzenRow>

@if (errorMessage != null)
{
    <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" Shade="Shade.Dark" AllowClose="true" Close="@(() => errorMessage = null)" class="rz-mt-4">
        <strong>Error:</strong> @errorMessage
    </RadzenAlert>
}

@if (!string.IsNullOrEmpty(exportedData))
{
    <RadzenCard class="rz-mt-4">
        <RadzenStack Gap="1rem">
            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center">
                <RadzenText TextStyle="TextStyle.H6">Exported Data (@exportedFormat.ToUpper())</RadzenText>
                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
                    <RadzenButton Text="Copy" Icon="content_copy" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" Click="@CopyToClipboard" />
                    <RadzenButton Text="Download" Icon="download" Size="ButtonSize.Small" Click="@DownloadFile" />
                </RadzenStack>
            </RadzenStack>

            <RadzenTextArea Value="@exportedData" ReadOnly="true" Rows="15" Style="width: 100%; font-family: monospace; font-size: 0.85rem;" />
        </RadzenStack>
    </RadzenCard>
}

@code {
    private bool includeCommentsJson = false;
    private bool includeCommentsCsv = false;
    private bool isExportingJson = false;
    private bool isExportingCsv = false;
    private string? errorMessage;
    private string? exportedData;
    private string exportedFormat = string.Empty;

    private async Task ExportToJson()
    {
        isExportingJson = true;
        errorMessage = null;
        exportedData = null;

        try
        {
            exportedData = await ExportApi.ExportToJsonAsync(includeCommentsJson);
            exportedFormat = "json";
            NotificationService.Notify(NotificationSeverity.Success, "Export Complete", "Resources exported to JSON");
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to export to JSON: {ex.Message}";
            NotificationService.Notify(NotificationSeverity.Error, "Export Failed", ex.Message);
        }
        finally
        {
            isExportingJson = false;
        }
    }

    private async Task ExportToCsv()
    {
        isExportingCsv = true;
        errorMessage = null;
        exportedData = null;

        try
        {
            exportedData = await ExportApi.ExportToCsvAsync(includeCommentsCsv);
            exportedFormat = "csv";
            NotificationService.Notify(NotificationSeverity.Success, "Export Complete", "Resources exported to CSV");
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to export to CSV: {ex.Message}";
            NotificationService.Notify(NotificationSeverity.Error, "Export Failed", ex.Message);
        }
        finally
        {
            isExportingCsv = false;
        }
    }

    private async Task CopyToClipboard()
    {
        if (string.IsNullOrEmpty(exportedData)) return;

        try
        {
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", exportedData);
            NotificationService.Notify(NotificationSeverity.Success, "Copied", "Content copied to clipboard");
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to copy to clipboard: {ex.Message}";
        }
    }

    private async Task DownloadFile()
    {
        if (string.IsNullOrEmpty(exportedData)) return;

        try
        {
            var fileName = $"resources-{DateTime.Now:yyyyMMdd-HHmmss}.{exportedFormat}";
            var bytes = System.Text.Encoding.UTF8.GetBytes(exportedData);
            var base64 = Convert.ToBase64String(bytes);
            await JSRuntime.InvokeVoidAsync("downloadFile", fileName, base64);
            NotificationService.Notify(NotificationSeverity.Success, "Downloaded", $"Saved as {fileName}");
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to download file: {ex.Message}";
        }
    }
}
