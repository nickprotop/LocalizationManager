@page "/editor/key/{KeyName}"
@using LocalizationManager.Services
@using LocalizationManager.Models.Api
@inject ResourceApiClient ResourceApi
@inject TranslationApiClient TranslationApi
@inject ScanApiClient ScanApi
@inject ScanCacheService ScanCache
@inject NavigationManager Navigation
@inject NotificationService NotificationService
@inject DialogService DialogService

<PageTitle>Edit Key - Localization Manager</PageTitle>

<RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" class="rz-mb-4">
    <RadzenButton Icon="arrow_back" ButtonStyle="ButtonStyle.Light" Click="@(() => Navigation.NavigateTo("/editor"))" />
    <RadzenText TextStyle="TextStyle.H4">Edit Key</RadzenText>
</RadzenStack>

@if (isLoading)
{
    <RadzenCard>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
            <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Small" />
            <RadzenText>Loading key details...</RadzenText>
        </RadzenStack>
    </RadzenCard>
}
else if (errorMessage != null)
{
    <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" Shade="Shade.Dark" AllowClose="true" Close="@(() => errorMessage = null)" class="rz-mb-4">
        <strong>Error:</strong> @errorMessage
        <RadzenButton Text="Back to Editor" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" class="rz-mt-2"
                     Click="@(() => Navigation.NavigateTo("/editor"))" />
    </RadzenAlert>
}
else if (keyDetails != null)
{
    <RadzenCard class="rz-mb-4">
        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center" class="rz-mb-4">
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                <code class="key-name" style="font-size: 1.25rem;">@KeyName</code>
                @if (keyDetails.HasDuplicates)
                {
                    <RadzenBadge BadgeStyle="BadgeStyle.Warning" Text="@($"{keyDetails.OccurrenceCount} occurrences")" />
                }
            </RadzenStack>
            <RadzenButton Text="Translate" Icon="translate" Click="@OpenTranslateDialog" />
        </RadzenStack>

        @if (successMessage != null)
        {
            <RadzenAlert AlertStyle="AlertStyle.Success" Variant="Variant.Flat" Shade="Shade.Dark" AllowClose="true"
                        Close="@(() => successMessage = null)" class="rz-mb-4">
                @successMessage
            </RadzenAlert>
        }

        @if (hasUnsavedTranslations)
        {
            <RadzenAlert AlertStyle="AlertStyle.Warning" Variant="Variant.Flat" Shade="Shade.Dark" AllowClose="false" class="rz-mb-4">
                Translations applied. Click "Save Changes" to save them.
            </RadzenAlert>
        }

        @if (keyDetails.HasDuplicates && keyDetails.Occurrences != null)
        {
            <RadzenFormField Text="Editing Occurrence" class="rz-mb-4" Style="width: 200px;">
                <RadzenDropDown @bind-Value="@selectedOccurrence" Data="@GetOccurrenceOptions()"
                               TextProperty="Text" ValueProperty="Value"
                               Change="@((object _) => OnOccurrenceChanged())" Style="width: 100%;" />
            </RadzenFormField>
        }

        <!-- Language Values -->
        <RadzenStack Gap="1rem">
            @foreach (var kvp in GetValuesForSelectedOccurrence())
            {
                var langCode = kvp.Key;
                var resourceValue = kvp.Value;
                var isEmpty = string.IsNullOrWhiteSpace(resourceValue.Value) &&
                              !(resourceValue.IsPlural && resourceValue.PluralForms?.Any() == true);
                var isDefault = langCode == defaultLanguageCode;

                <RadzenFieldset>
                    <HeaderTemplate>
                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                            <RadzenText>@langCode</RadzenText>
                            @if (isDefault)
                            {
                                <RadzenBadge BadgeStyle="BadgeStyle.Info" Text="Source" />
                            }
                            @if (resourceValue.IsPlural)
                            {
                                <RadzenBadge BadgeStyle="BadgeStyle.Success" Text="Plural" />
                            }
                            @if (isEmpty && !isDefault)
                            {
                                <RadzenBadge BadgeStyle="BadgeStyle.Warning" Text="Empty" />
                            }
                        </RadzenStack>
                    </HeaderTemplate>
                    <ChildContent>
                        @if (resourceValue.IsPlural)
                        {
                            <RadzenStack Gap="0.5rem">
                                @foreach (var form in new[] { "one", "other", "zero" })
                                {
                                    var formValue = GetPluralFormValue(langCode, form);
                                    <RadzenFormField Text="@form" Style="width: 100%;">
                                        <RadzenTextBox Value="@formValue"
                                                      ValueChanged="@((string v) => SetPluralFormValue(langCode, form, v))"
                                                      Placeholder="@($"Enter {form} form (e.g., {{0}} item{(form == "other" ? "s" : "")})")"
                                                      Style="width: 100%;" />
                                    </RadzenFormField>
                                }
                            </RadzenStack>
                        }
                        else
                        {
                            <RadzenTextArea @bind-Value="@editedValues[langCode].Value" Rows="2" Style="width: 100%;" />
                        }

                        @if (!string.IsNullOrWhiteSpace(resourceValue.Comment) || (editingComments.ContainsKey(langCode) && editingComments[langCode]))
                        {
                            <RadzenFormField Text="Comment" class="rz-mt-2" Style="width: 100%;">
                                <RadzenTextBox @bind-Value="@editedValues[langCode].Comment"
                                              Placeholder="Enter comment for translators" Style="width: 100%;" />
                            </RadzenFormField>
                        }

                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.25rem" class="rz-mt-2">
                            <RadzenCheckBox Value="@(editingComments.ContainsKey(langCode) && editingComments[langCode] || !string.IsNullOrWhiteSpace(resourceValue.Comment))"
                                           TValue="bool" ValueChanged="@((bool v) => ToggleComment(langCode, v))" Name="@($"cbComment_{langCode}")" />
                            <RadzenLabel Text="Show comment field" Component="@($"cbComment_{langCode}")" />
                        </RadzenStack>
                    </ChildContent>
                </RadzenFieldset>
            }

            <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" Wrap="FlexWrap.Wrap">
                <RadzenButton Text="@(isSaving ? "Saving..." : "Save Changes")" Icon="save"
                             Click="@SaveChanges" Disabled="@isSaving" IsBusy="@isSaving" />
                <RadzenButton Text="Cancel" ButtonStyle="ButtonStyle.Light" Click="@(() => Navigation.NavigateTo("/editor"))" />
                @if (supportsPluralFormat)
                {
                    @if (IsCurrentKeyPlural())
                    {
                        <RadzenButton Text="Convert to Simple" ButtonStyle="ButtonStyle.Secondary" Click="@ConvertToSimple" />
                    }
                    else
                    {
                        <RadzenButton Text="Convert to Plural" ButtonStyle="ButtonStyle.Secondary" Click="@ConvertToPlural" />
                    }
                }
                <RadzenButton Text="Delete Key" Icon="delete" ButtonStyle="ButtonStyle.Danger" Click="@DeleteKey" />
            </RadzenStack>
        </RadzenStack>
    </RadzenCard>

    <!-- Code References Section -->
    <RadzenCard>
        <RadzenText TextStyle="TextStyle.H6" class="rz-mb-4">Code References</RadzenText>
        @if (isLoadingReferences)
        {
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Small" />
                <RadzenText class="rz-color-secondary">Scanning code for references...</RadzenText>
            </RadzenStack>
        }
        else if (codeReferences != null)
        {
            @if (codeReferences.Count == 0)
            {
                <RadzenAlert AlertStyle="AlertStyle.Warning" Variant="Variant.Flat" Shade="Shade.Dark" AllowClose="false">
                    No references found in source code. This key may be unused.
                </RadzenAlert>
            }
            else
            {
                <RadzenAlert AlertStyle="AlertStyle.Success" Variant="Variant.Flat" Shade="Shade.Dark" AllowClose="false" class="rz-mb-4">
                    Found @codeReferences.Count reference(s) in source code
                </RadzenAlert>
                <RadzenDataGrid Data="@codeReferences" TItem="CodeReference" AllowSorting="true">
                    <Columns>
                        <RadzenDataGridColumn TItem="CodeReference" Property="File" Title="File">
                            <Template Context="reference">
                                <code title="@reference.File">@GetFileName(reference.File)</code>
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="CodeReference" Property="Line" Title="Line" Width="80px" />
                        <RadzenDataGridColumn TItem="CodeReference" Property="Pattern" Title="Pattern">
                            <Template Context="reference">
                                <code>@reference.Pattern</code>
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="CodeReference" Property="Confidence" Title="Confidence" Width="120px">
                            <Template Context="reference">
                                @if (reference.Confidence == "High")
                                {
                                    <RadzenBadge BadgeStyle="BadgeStyle.Success" Text="@reference.Confidence" />
                                }
                                else if (reference.Confidence == "Medium")
                                {
                                    <RadzenBadge BadgeStyle="BadgeStyle.Warning" Text="@reference.Confidence" />
                                }
                                else
                                {
                                    <RadzenBadge BadgeStyle="BadgeStyle.Info" Text="@reference.Confidence" />
                                }
                            </Template>
                        </RadzenDataGridColumn>
                    </Columns>
                </RadzenDataGrid>
            }
            @if (ScanCache.ScanTimestamp.HasValue)
            {
                <RadzenText TextStyle="TextStyle.Caption" class="rz-color-secondary rz-mt-2">
                    Last scan: @ScanCache.ScanTimestamp.Value.ToString("HH:mm:ss")
                </RadzenText>
            }
        }
        else
        {
            <RadzenText class="rz-color-secondary">
                No code scan cache available. Run a code scan to see where this key is used.
            </RadzenText>
        }
        <RadzenButton Text="@(isScanning ? "Scanning..." : (codeReferences != null ? "Re-scan Code" : "Scan Code"))"
                     Icon="search" ButtonStyle="ButtonStyle.Secondary" class="rz-mt-2"
                     Click="@RunCodeScan" Disabled="@isScanning" IsBusy="@isScanning" />
    </RadzenCard>
}

@code {
    [Parameter]
    public string KeyName { get; set; } = string.Empty;

    private ResourceKeyDetails? keyDetails;
    private Dictionary<string, ResourceValue> editedValues = new();
    private Dictionary<string, bool> editingComments = new();
    private List<CodeReference>? codeReferences;
    private List<TranslationProviderInfo>? availableProviders;
    private int selectedOccurrence = 1;
    private bool isLoading = true;
    private bool isSaving = false;
    private bool isLoadingReferences = false;
    private bool isScanning = false;
    private string? errorMessage;
    private string? successMessage;
    private string? defaultLanguageCode;
    private bool hasUnsavedTranslations = false;
    private bool supportsPluralFormat = false;

    // Translate dialog state
    private string selectedProvider = "google";
    private HashSet<string> translateTargetLanguages = new();
    private bool translateOnlyMissing = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadKeyDetails();
        await LoadProviders();
        LoadReferencesFromCache();
    }

    private void LoadReferencesFromCache()
    {
        if (ScanCache.TryGetReferences(KeyName, out var cached))
        {
            codeReferences = cached ?? new List<CodeReference>();
        }
        else
        {
            codeReferences = null;
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!isLoading)
        {
            await LoadKeyDetails();
        }
    }

    private async Task LoadProviders()
    {
        try
        {
            var providers = await TranslationApi.GetProvidersAsync();
            availableProviders = providers?.Providers;
        }
        catch { /* Ignore provider loading errors */ }
    }

    private async Task LoadKeyDetails()
    {
        isLoading = true;
        errorMessage = null;
        successMessage = null;
        hasUnsavedTranslations = false;

        try
        {
            keyDetails = await ResourceApi.GetKeyAsync(KeyName);
            if (keyDetails != null)
            {
                InitializeEditedValues();

                var languages = await ResourceApi.GetResourceFilesAsync();
                defaultLanguageCode = languages?.FirstOrDefault(l => l.IsDefault)?.Code ?? "default";

                supportsPluralFormat = languages?.Any(l =>
                    l.FilePath?.EndsWith(".json", StringComparison.OrdinalIgnoreCase) == true) ?? false;

                translateTargetLanguages = editedValues.Keys
                    .Where(k => k != defaultLanguageCode)
                    .ToHashSet();

                LoadReferencesFromCache();
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to load key details: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void InitializeEditedValues()
    {
        if (keyDetails == null) return;

        Dictionary<string, ResourceValue> sourceValues;

        if (keyDetails.HasDuplicates && keyDetails.Occurrences != null && selectedOccurrence > 0 && selectedOccurrence <= keyDetails.Occurrences.Count)
        {
            sourceValues = keyDetails.Occurrences[selectedOccurrence - 1].Values;
        }
        else
        {
            sourceValues = keyDetails.Values;
        }

        editedValues = sourceValues.ToDictionary(
            kvp => kvp.Key,
            kvp => new ResourceValue
            {
                Value = kvp.Value.Value,
                Comment = kvp.Value.Comment,
                IsPlural = kvp.Value.IsPlural,
                PluralForms = kvp.Value.PluralForms != null
                    ? new Dictionary<string, string>(kvp.Value.PluralForms)
                    : null
            });

        editingComments = editedValues.ToDictionary(
            kvp => kvp.Key,
            kvp => !string.IsNullOrWhiteSpace(kvp.Value.Comment));
    }

    private List<object> GetOccurrenceOptions()
    {
        var options = new List<object>();
        for (int i = 1; i <= (keyDetails?.OccurrenceCount ?? 1); i++)
        {
            options.Add(new { Text = $"Occurrence {i}", Value = i });
        }
        return options;
    }

    private string GetPluralFormValue(string langCode, string form)
    {
        if (editedValues.TryGetValue(langCode, out var val) && val.PluralForms != null)
        {
            return val.PluralForms.GetValueOrDefault(form, string.Empty);
        }
        return string.Empty;
    }

    private void SetPluralFormValue(string langCode, string form, string value)
    {
        if (editedValues.TryGetValue(langCode, out var resourceValue))
        {
            resourceValue.PluralForms ??= new Dictionary<string, string>();
            if (string.IsNullOrEmpty(value))
            {
                resourceValue.PluralForms.Remove(form);
            }
            else
            {
                resourceValue.PluralForms[form] = value;
            }
            resourceValue.Value = resourceValue.PluralForms.GetValueOrDefault("other")
                ?? resourceValue.PluralForms.Values.FirstOrDefault();
        }
    }

    private void OnOccurrenceChanged()
    {
        InitializeEditedValues();
        hasUnsavedTranslations = false;
    }

    private Dictionary<string, ResourceValue> GetValuesForSelectedOccurrence()
    {
        return editedValues;
    }

    private string? GetSourceValue()
    {
        if (defaultLanguageCode != null && editedValues.TryGetValue(defaultLanguageCode, out var val))
        {
            return val.Value;
        }
        return editedValues.Values.FirstOrDefault()?.Value;
    }

    private void ToggleComment(string languageCode, bool enabled)
    {
        editingComments[languageCode] = enabled;
        if (!enabled && editedValues.ContainsKey(languageCode))
        {
            editedValues[languageCode].Comment = null;
        }
    }

    private async Task SaveChanges()
    {
        isSaving = true;
        errorMessage = null;
        successMessage = null;

        try
        {
            var request = new UpdateKeyRequest
            {
                Values = editedValues.ToDictionary(
                    kvp => kvp.Key,
                    kvp => new ResourceValue
                    {
                        Value = kvp.Value.Value ?? string.Empty,
                        Comment = kvp.Value.Comment,
                        IsPlural = kvp.Value.IsPlural,
                        PluralForms = kvp.Value.PluralForms
                    }),
                Occurrence = keyDetails?.HasDuplicates == true ? selectedOccurrence : null
            };

            var result = await ResourceApi.UpdateKeyAsync(KeyName, request);
            if (result?.Success == true)
            {
                successMessage = result.Message ?? "Key updated successfully";
                hasUnsavedTranslations = false;
                NotificationService.Notify(NotificationSeverity.Success, "Saved", successMessage);
                await LoadKeyDetails();
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to save changes: {ex.Message}";
            NotificationService.Notify(NotificationSeverity.Error, "Save Failed", ex.Message);
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task OpenTranslateDialog()
    {
        var result = await DialogService.OpenAsync<TranslateKeyDialog>($"Translate: {KeyName}",
            new Dictionary<string, object>
            {
                { "KeyName", KeyName },
                { "EditedValues", editedValues },
                { "DefaultLanguageCode", defaultLanguageCode ?? "default" },
                { "AvailableProviders", availableProviders ?? new List<TranslationProviderInfo>() }
            },
            new DialogOptions { Width = "600px", Height = "500px", Resizable = true, Draggable = true });

        if (result is Dictionary<string, string> translations)
        {
            foreach (var kvp in translations)
            {
                if (editedValues.ContainsKey(kvp.Key))
                {
                    editedValues[kvp.Key].Value = kvp.Value;
                }
            }
            hasUnsavedTranslations = true;
            successMessage = $"Applied {translations.Count} translation(s). Click 'Save Changes' to save.";
            StateHasChanged();
        }
    }

    private async Task RunCodeScan()
    {
        isScanning = true;
        errorMessage = null;

        try
        {
            var scanResult = await ScanApi.ScanAsync();
            if (scanResult != null)
            {
                ScanCache.CacheScanResult(scanResult);
                LoadReferencesFromCache();
                NotificationService.Notify(NotificationSeverity.Success, "Scan Complete", "Code scan completed");
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to scan code: {ex.Message}";
            NotificationService.Notify(NotificationSeverity.Error, "Scan Failed", ex.Message);
        }
        finally
        {
            isScanning = false;
        }
    }

    private async Task DeleteKey()
    {
        var confirmed = await DialogService.Confirm(
            $"Are you sure you want to delete the key '<strong>{KeyName}</strong>'?",
            "Confirm Delete",
            new ConfirmOptions { OkButtonText = "Delete", CancelButtonText = "Cancel" });

        if (confirmed != true) return;

        errorMessage = null;

        try
        {
            var occurrence = keyDetails?.HasDuplicates == true ? selectedOccurrence : (int?)null;
            var result = await ResourceApi.DeleteKeyAsync(KeyName, occurrence);
            if (result?.Success == true)
            {
                NotificationService.Notify(NotificationSeverity.Success, "Deleted", $"Key '{KeyName}' deleted");
                Navigation.NavigateTo("/editor");
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to delete key: {ex.Message}";
            NotificationService.Notify(NotificationSeverity.Error, "Delete Failed", ex.Message);
        }
    }

    private string GetFileName(string filePath)
    {
        if (string.IsNullOrEmpty(filePath)) return filePath;
        var lastSlash = filePath.LastIndexOfAny(new[] { '/', '\\' });
        return lastSlash >= 0 ? filePath.Substring(lastSlash + 1) : filePath;
    }

    private bool IsCurrentKeyPlural()
    {
        return editedValues.Values.Any(v => v.IsPlural);
    }

    private void ConvertToPlural()
    {
        foreach (var langCode in editedValues.Keys.ToList())
        {
            var resourceValue = editedValues[langCode];
            if (!resourceValue.IsPlural)
            {
                var currentValue = resourceValue.Value ?? string.Empty;
                resourceValue.IsPlural = true;
                resourceValue.PluralForms = new Dictionary<string, string>
                {
                    ["other"] = currentValue
                };
            }
        }

        successMessage = "Converted to plural key. Add plural form values and click 'Save Changes' to save.";
        hasUnsavedTranslations = true;
        StateHasChanged();
    }

    private void ConvertToSimple()
    {
        foreach (var langCode in editedValues.Keys.ToList())
        {
            var resourceValue = editedValues[langCode];
            if (resourceValue.IsPlural)
            {
                var simpleValue = resourceValue.PluralForms?.GetValueOrDefault("other")
                    ?? resourceValue.PluralForms?.Values.FirstOrDefault()
                    ?? resourceValue.Value
                    ?? string.Empty;

                resourceValue.IsPlural = false;
                resourceValue.Value = simpleValue;
                resourceValue.PluralForms = null;
            }
        }

        successMessage = "Converted to simple key. Click 'Save Changes' to save.";
        hasUnsavedTranslations = true;
        StateHasChanged();
    }
}
