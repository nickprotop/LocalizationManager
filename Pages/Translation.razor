@page "/translation"
@using LocalizationManager.Services
@using LocalizationManager.Models.Api
@inject TranslationApiClient TranslationApi
@inject LanguageApiClient LanguageApi
@inject NotificationService NotificationService

<PageTitle>Translation - Localization Manager</PageTitle>

<RadzenText TextStyle="TextStyle.H4" class="rz-mb-4">Machine Translation</RadzenText>

@if (isLoading)
{
    <RadzenCard>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
            <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Small" />
            <RadzenText>Loading translation options...</RadzenText>
        </RadzenStack>
    </RadzenCard>
}
else if (errorMessage != null)
{
    <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" Shade="Shade.Dark" AllowClose="true" Close="@(() => errorMessage = null)">
        <strong>Error:</strong> @errorMessage
    </RadzenAlert>
}
else
{
    <RadzenCard class="rz-mb-4">
        <RadzenText TextStyle="TextStyle.H6" class="rz-mb-4">Translate Missing Keys</RadzenText>
        <RadzenText TextStyle="TextStyle.Body2" class="rz-mb-4 rz-color-secondary">
            Automatically translate missing translations using machine translation providers.
        </RadzenText>

        <RadzenStack Gap="1rem">
            <!-- Provider Selection -->
            <RadzenFormField Text="Translation Provider" Style="width: 100%; max-width: 400px;">
                <RadzenDropDown @bind-Value="@selectedProvider" Data="@providers?.Providers"
                               TextProperty="DisplayName" ValueProperty="Name"
                               Style="width: 100%;" />
            </RadzenFormField>

            <!-- Source Language -->
            <RadzenFormField Text="Source Language" Style="width: 100%; max-width: 400px;">
                <RadzenDropDown @bind-Value="@selectedSourceLanguage"
                               Data="@languages?.Languages.Where(l => l.IsDefault)"
                               TextProperty="DisplayName" ValueProperty="Code"
                               Style="width: 100%;" />
            </RadzenFormField>

            <!-- Target Languages -->
            <RadzenFieldset Text="Target Languages">
                <RadzenStack Orientation="Orientation.Horizontal" Gap="1rem" Wrap="FlexWrap.Wrap">
                    @if (languages != null)
                    {
                        @foreach (var lang in languages.Languages.Where(l => !l.IsDefault))
                        {
                            var langCode = lang.Code ?? "default";
                            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.25rem">
                                <RadzenCheckBox Value="@targetLanguages.Contains(langCode)" TValue="bool"
                                               ValueChanged="@((bool v) => ToggleTargetLanguage(langCode, v))"
                                               Name="@($"cbLang_{langCode}")" />
                                <RadzenLabel Component="@($"cbLang_{langCode}")">
                                    @lang.DisplayName
                                    <RadzenBadge BadgeStyle="@(lang.Coverage == 100 ? BadgeStyle.Success : lang.Coverage < 50 ? BadgeStyle.Danger : BadgeStyle.Warning)"
                                                Text="@($"{lang.Coverage}%")" class="rz-ml-1" />
                                </RadzenLabel>
                            </RadzenStack>
                        }
                    }
                </RadzenStack>
            </RadzenFieldset>

            <!-- Options -->
            <RadzenStack Orientation="Orientation.Horizontal" Gap="1.5rem" Wrap="FlexWrap.Wrap">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.25rem">
                    <RadzenCheckBox @bind-Value="@onlyMissing" Name="cbOnlyMissing" />
                    <RadzenLabel Text="Only translate missing values" Component="cbOnlyMissing" />
                </RadzenStack>

                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.25rem">
                    <RadzenCheckBox @bind-Value="@dryRun" Name="cbDryRun" />
                    <RadzenLabel Text="Dry run (preview without saving)" Component="cbDryRun" />
                </RadzenStack>
            </RadzenStack>

            <!-- Action Button -->
            <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
                <RadzenButton Text="@(isTranslating ? "Translating..." : "Start Translation")"
                             Icon="translate" Click="@StartTranslation"
                             Disabled="@(isTranslating || !targetLanguages.Any())"
                             IsBusy="@isTranslating" />
                @if (targetLanguages.Any())
                {
                    <RadzenText TextStyle="TextStyle.Body2" class="rz-color-secondary rz-align-self-center">
                        @targetLanguages.Count language(s) selected
                    </RadzenText>
                }
            </RadzenStack>
        </RadzenStack>
    </RadzenCard>

    @if (isTranslating)
    {
        <RadzenCard class="rz-mb-4">
            <RadzenStack AlignItems="AlignItems.Center" Gap="1rem">
                <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
                <RadzenText>Translating... Please wait.</RadzenText>
            </RadzenStack>
        </RadzenCard>
    }

    @if (translationResult != null)
    {
        <RadzenAlert AlertStyle="@(translationResult.Success ? AlertStyle.Success : AlertStyle.Warning)"
                    Variant="Variant.Flat" Shade="Shade.Dark" AllowClose="false" class="rz-mb-4">
            <RadzenText TextStyle="TextStyle.H6" class="rz-mb-2">Translation Results</RadzenText>
            <RadzenStack Orientation="Orientation.Horizontal" Gap="1.5rem" Wrap="FlexWrap.Wrap" class="rz-mb-2">
                <RadzenText><strong>Translated:</strong> @translationResult.TranslatedCount keys</RadzenText>
                <RadzenText><strong>Errors:</strong> @translationResult.ErrorCount</RadzenText>
            </RadzenStack>
            @if (translationResult.DryRun)
            {
                <RadzenText TextStyle="TextStyle.Caption" class="rz-color-secondary">
                    <em>Dry run - no changes saved</em>
                </RadzenText>
            }
        </RadzenAlert>

        @if (translationResult.Results.Any())
        {
            <RadzenCard class="rz-mb-4">
                <RadzenText TextStyle="TextStyle.H6" class="rz-mb-4">
                    Translated Keys (@translationResult.Results.Count)
                </RadzenText>
                <RadzenDataGrid Data="@translationResult.Results" TItem="TranslationResult"
                               AllowSorting="true" AllowPaging="true" PageSize="25"
                               PagerHorizontalAlign="HorizontalAlign.Center">
                    <Columns>
                        <RadzenDataGridColumn TItem="TranslationResult" Property="Key" Title="Key" Width="200px">
                            <Template Context="item">
                                <code class="key-name">@item.Key</code>
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="TranslationResult" Property="Language" Title="Language" Width="100px" />
                        <RadzenDataGridColumn TItem="TranslationResult" Property="TranslatedValue" Title="Translated Value" />
                    </Columns>
                </RadzenDataGrid>
            </RadzenCard>
        }

        @if (translationResult.Errors.Any())
        {
            <RadzenCard>
                <RadzenText TextStyle="TextStyle.H6" class="rz-mb-4 rz-color-danger">
                    Translation Errors (@translationResult.Errors.Count)
                </RadzenText>
                <RadzenDataGrid Data="@translationResult.Errors" TItem="TranslationError"
                               AllowSorting="true" AllowPaging="true" PageSize="10"
                               PagerHorizontalAlign="HorizontalAlign.Center">
                    <Columns>
                        <RadzenDataGridColumn TItem="TranslationError" Property="Key" Title="Key" Width="200px">
                            <Template Context="item">
                                <code class="key-name">@item.Key</code>
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="TranslationError" Property="Language" Title="Language" Width="100px" />
                        <RadzenDataGridColumn TItem="TranslationError" Property="Error" Title="Error" />
                    </Columns>
                </RadzenDataGrid>
            </RadzenCard>
        }
    }
}

@code {
    private TranslationProvidersResponse? providers;
    private LanguagesResponse? languages;
    private bool isLoading = true;
    private bool isTranslating = false;
    private string? errorMessage;
    private string selectedProvider = "google";
    private string? selectedSourceLanguage;
    private HashSet<string> targetLanguages = new();
    private bool onlyMissing = true;
    private bool dryRun = false;
    private Models.Api.TranslationResponse? translationResult;

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;

        try
        {
            providers = await TranslationApi.GetProvidersAsync();
            languages = await LanguageApi.GetLanguagesAsync();

            if (languages != null)
            {
                // Set default source language
                var defaultLang = languages.Languages.FirstOrDefault(l => l.IsDefault);
                selectedSourceLanguage = defaultLang?.Code ?? "default";

                // Pre-select all non-default languages
                foreach (var lang in languages.Languages.Where(l => !l.IsDefault))
                {
                    targetLanguages.Add(lang.Code ?? "default");
                }
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to load translation options: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ToggleTargetLanguage(string languageCode, bool isChecked)
    {
        if (isChecked) targetLanguages.Add(languageCode);
        else targetLanguages.Remove(languageCode);
    }

    private async Task StartTranslation()
    {
        isTranslating = true;
        errorMessage = null;
        translationResult = null;

        try
        {
            var request = new TranslateRequest
            {
                Provider = selectedProvider,
                SourceLanguage = selectedSourceLanguage ?? "default",
                TargetLanguages = targetLanguages.ToList(),
                OnlyMissing = onlyMissing,
                DryRun = dryRun
            };

            translationResult = await TranslationApi.TranslateAsync(request);

            if (translationResult.Success)
            {
                NotificationService.Notify(NotificationSeverity.Success, "Translation Complete",
                    $"Translated {translationResult.TranslatedCount} keys" + (dryRun ? " (dry run)" : ""));
            }
            else
            {
                NotificationService.Notify(NotificationSeverity.Warning, "Translation Completed with Errors",
                    $"{translationResult.ErrorCount} error(s) occurred");
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Translation failed: {ex.Message}";
            NotificationService.Notify(NotificationSeverity.Error, "Translation Failed", ex.Message);
        }
        finally
        {
            isTranslating = false;
        }
    }
}
